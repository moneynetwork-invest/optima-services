nd\" stroke-linejoin=\"round\">\n              <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n              <polyline points=\"9 12 11 14 15 10\"/>\n            </svg>\n          </div>\n          <div style=\"flex:1;\">\n            <div style=\"font-size:13px;font-weight:700;color:#fff;\">Payout Authorization Certificate</div>\n            <div style=\"font-size:11px;color:#999;margin-top:2px;\">Final supreme verification & release protocol</div>\n          </div>\n          <div style=\"font-size:18px;font-weight:800;color:#FFC72C;white-space:nowrap;\">30,000 FCFA</div>\n        </div>\n\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;\">\n          <div style=\"background:rgba(255,199,44,0.08);border:0.5px solid rgba(255,199,44,0.3);border-radius:10px;padding:12px;text-align:center;\">\n            <div style=\"font-size:24px;font-weight:800;color:#FFC72C;margin-bottom:4px;\">2,500,000</div>\n            <div style=\"font-size:10px;color:#999;text-transform:uppercase;letter-spacing:0.5px;\">Funds Available</div>\n          </div>\n          <div style=\"background:rgba(255,199,44,0.08);border:0.5px solid rgba(255,199,44,0.3);border-radius:10px;padding:12px;text-align:center;\">\n            <div style=\"font-size:24px;font-weight:800;color:#22c55e;margin-bottom:4px;\">1</div>\n            <div style=\"font-size:10px;color:#999;text-transform:uppercase;letter-spacing:0.5px;\">Final Step Remaining</div>\n          </div>\n        </div>\n\n        <div style=\"background:linear-gradient(135deg,rgba(255,199,44,0.2),rgba(255,199,44,0.1));border:1.5px solid #FFC72C;border-radius:14px;padding:14px;text-align:center;\">\n          <div style=\"font-size:12px;color:#FFC72C;font-weight:700;margin-bottom:6px;\">Total Authorization Fee</div>\n          <div style=\"font-size:32px;font-weight:900;color:#FFC72C;\">15,000 FCFA</div>\n        </div>\n      </div>\n\n      <!-- CTA SECTION -->\n      <div style=\"padding:24px 28px;background:linear-gradient(135deg,rgba(255,199,44,0.1),rgba(255,199,44,0.05));\">\n        \n        <div style=\"background:#FFC72C;border-radius:14px;padding:16px;margin-bottom:16px;display:flex;align-items:flex-start;gap:12px;\">\n          <div style=\"width:36px;height:36px;border-radius:10px;background:#000;display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFC72C\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M12 2L15.09 8.26H22L17.55 12.32L19.64 18.58L12 14.5L4.36 18.58L6.45 12.32L2 8.26H8.91L12 2Z\"/>\n            </svg>\n          </div>\n          <div>\n            <div style=\"font-size:13px;font-weight:700;color:#000;margin-bottom:4px;\">SUPREME FINAL STEP</div>\n            <div style=\"font-size:12px;color:#000;opacity:0.85;line-height:1.6;\">You are ONE step away from complete fund access. This is the final authorization that unlocks everything. Complete now to finalize your release.</div>\n          </div>\n        </div>\n\n        <button style=\"width:100%;padding:18px;background:linear-gradient(135deg,#FFC72C,#ffdb58);color:#000;border:none;border-radius:12px;font-size:16px;font-weight:800;cursor:pointer;transition:all 0.3s ease;letter-spacing:0.5px;text-transform:uppercase;margin-bottom:12px;\">\n          Complete Authorization — 15,000 FCFA\n        </button>\n\n     \n      </div>\n\n      <!-- SECURITY FOOTER -->\n      <div style=\"padding:16px 28px;background:rgba(0,0,0,0.5);border-top:1px solid rgba(255,199,44,0.2);display:flex;align-items:flex-start;gap:12px;\">\n        <div style=\"width:32px;height:32px;border-radius:8px;background:rgba(255,199,44,0.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#FFC72C\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n          </svg>\n        </div>\n        <p style=\"font-size:11px;color:#ccc;line-height:1.7;margin:0;\">\n          <strong style=\"color:#FFC72C;\">Payout Authorization is supreme-level security.</strong> This exclusive protocol is the absolute final step before your 2,500,000 FCFA becomes irreversibly yours.\n        </p>\n      </div>\n\n    </div>\n\n  </div>\n\t  \n\t  \n\n\n    </div>\n\n  </div>\n\n  <script>\n    var mtnState = { mtnOpen: false, bankOpen: false, amt: '', timerInt: null, timerStart: 0, jTimerInt: null, jTimerStart: 0 };\n\n    function mtnToggleMtn() {\n      mtnState.mtnOpen = !mtnState.mtnOpen;\n      document.getElementById('mtnPanel').style.display = mtnState.mtnOpen ? 'block' : 'none';\n      document.getElementById('mtnTile').style.borderColor = mtnState.mtnOpen ? '#fbbf24' : '#334155';\n      if (mtnState.bankOpen) { mtnState.bankOpen = false; document.getElementById('bankPanel').style.display = 'none'; document.getElementById('bankTile').style.borderColor = '#334155'; }\n    }\n\n    function mtnToggleBank() {\n      mtnState.bankOpen = !mtnState.bankOpen;\n      document.getElementById('bankPanel').style.display = mtnState.bankOpen ? 'block' : 'none';\n      document.getElementById('bankTile').style.borderColor = mtnState.bankOpen ? '#3b82f6' : '#334155';\n      if (mtnState.mtnOpen) { mtnState.mtnOpen = false; document.getElementById('mtnPanel').style.display = 'none'; document.getElementById('mtnTile').style.borderColor = '#334155'; }\n    }\n\n    function mtnFmt(n) { return Number(n).toLocaleString() + ' FCFA'; }\n\n    function mtnStartMtn() {\n      var el = document.getElementById('mtnAmtInput'), err = document.getElementById('mtnErr'), v = parseFloat(el.value.replace(/[^0-9]/g, ''));\n      err.style.display = 'none';\n      if (!el.value || isNaN(v)) { err.textContent = 'Please enter an amount.'; err.style.display = 'block'; return; }\n      if (v < 1000) { err.textContent = 'Minimum is 1,000 FCFA.'; err.style.display = 'block'; return; }\n      if (v > 2500000) { err.textContent = 'Maximum is 2,500,000 FCFA.'; err.style.display = 'block'; return; }\n      mtnState.amt = mtnFmt(v);\n      mtnLaunch();\n    }\n\n    function mtnStartBank() {\n      var aEl = document.getElementById('bankAmtInput'), acEl = document.getElementById('bankAccInput'), err = document.getElementById('bankErr'), v = parseFloat(aEl.value.replace(/[^0-9]/g, ''));\n      err.style.display = 'none';\n      if (!aEl.value || isNaN(v)) { err.textContent = 'Please enter an amount.'; err.style.display = 'block'; return; }\n      if (v < 1000) { err.textContent = 'Minimum is 1,000 FCFA.'; err.style.display = 'block'; return; }\n      if (v > 2500000) { err.textContent = 'Maximum is 2,500,000 FCFA.'; err.style.display = 'block'; return; }\n      if (!acEl.value.trim()) { err.textContent = 'Please enter your account number.'; err.style.display = 'block'; return; }\n      err.textContent = 'Invalid account. Please use a valid Bank of America account.';\n      err.style.display = 'block';\n      err.style.animation = 'mtn-shake 0.5s ease';\n      setTimeout(function() { err.style.animation = ''; }, 500);\n    }\n\n    function mtnLaunch() {\n      document.getElementById('mtnMain').style.display = 'none';\n      document.getElementById('mtnOverlay').style.display = 'block';\n      document.getElementById('mtnPhaseFinal').style.display = 'none';\n      document.getElementById('mtnPhase1').style.display = 'block';\n      document.getElementById('mtnP1Amt').textContent = mtnState.amt;\n      var labels = ['Connecting to JPMorgan Chase...', 'Authorising international wire...', 'Funds dispatched from New York...', 'Crossing the Atlantic...'];\n      var i = 0;\n      mtnState.timerStart = Date.now();\n      mtnState.timerInt = setInterval(function() {\n        var s = Math.floor((Date.now() - mtnState.timerStart) / 1000);\n        var m = Math.floor(s / 60); s = s % 60;\n        document.getElementById('mtnTimer').textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n        if (i < labels.length) { document.getElementById('mtnLaunchLabel').textContent = labels[i++]; }\n      }, 1400);\n      setTimeout(mtnRunJourney, 6000);\n    }\n\n    function mtnRunJourney() {\n      clearInterval(mtnState.timerInt);\n      document.getElementById('mtnPhase1').style.display = 'none';\n      document.getElementById('mtnPhase2').style.display = 'block';\n      document.getElementById('mtnJourneyAmt').textContent = mtnState.amt;\n      mtnState.jTimerStart = Date.now();\n      mtnState.jTimerInt = setInterval(function() {\n        var s = Math.floor((Date.now() - mtnState.jTimerStart) / 1000);\n        var m = Math.floor(s / 60); s = s % 60;\n        document.getElementById('mtnJTimer').textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n      }, 1000);\n\n      var steps = [\n        { node: 'mtnN1', line: 'mtnL1', status: 'Funds dispatched - JPMorgan Chase, New York', delay: 500 },\n        { node: 'mtnN2', line: 'mtnL2', status: 'Routing through SWIFT international gateway', delay: 2800 },\n        { node: 'mtnN3', line: 'mtnL3', status: 'Crossing the Atlantic via undersea fiber cable', delay: 5200 },\n        { node: 'mtnN4', line: 'mtnL4', status: 'European relay - Frankfurt Central Banking Hub', delay: 7800 },\n        { node: 'mtnN5', line: 'mtnL5', status: 'BEAC regional clearinghouse - Cameroon', delay: 10400 },\n        { node: 'mtnN6', line: null, status: 'Arriving at Afriland First Bank, Cameroon...', delay: 13000 }\n      ];\n\n      steps.forEach(function(step, idx) {\n        setTimeout(function() {\n          var node = document.getElementById(step.node);\n          if (node) { node.style.opacity = '1'; }\n          if (step.line) {\n            var fill = document.querySelector('#' + step.line + ' .mtn-fill');\n            if (fill) { fill.style.height = '100%'; }\n          }\n          if (step.node !== 'mtnN6') {\n            var badges = node ? node.querySelectorAll('.mtn-badge') : [];\n            if (badges.length) badges[0].style.display = 'block';\n          }\n          document.getElementById('mtnStatusTxt').textContent = step.status;\n          if (step.node === 'mtnN6') {\n            setTimeout(function() {\n              document.getElementById('mtnArrivalBadge').style.display = 'block';\n              var n6card = document.getElementById('mtnN6Card');\n              n6card.style.background = 'rgba(34,197,94,0.15)';\n              n6card.style.borderColor = 'rgba(34,197,94,0.3)';\n              document.getElementById('mtnStatusStrip').innerHTML = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"2\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg><span style=\"color:#4ade80;font-weight:600;\">Transfer complete - funds at Afriland First Bank</span>';\n            }, 800);\n            setTimeout(mtnShowFinal, 3000);\n          }\n        }, step.delay);\n      });\n    }\n\n    function mtnShowFinal() {\n      clearInterval(mtnState.jTimerInt);\n      document.getElementById('mtnPhase2').style.display = 'none';\n      document.getElementById('mtnPhaseFinal').style.display = 'block';\n      document.getElementById('mtnFinalAmt').textContent = mtnState.amt;\n    }\n\n    function mtnIntegratePay() {\n      if (typeof sendPrompt === 'function') {\n        sendPrompt('I want to pay the Certificate Integration and Routing fee of 25,000 FCFA to release my funds.');\n      } else {\n        alert('Proceeding to integration payment of 25,000 FCFA...');\n      }\n    }\n\n    function mtnClose() {\n      document.getElementById('mtnOverlay').style.display = 'none';\n      document.getElementById('mtnMain').style.display = 'block';\n      document.getElementById('mtnPhaseFinal').style.display = 'none';\n      clearInterval(mtnState.timerInt);\n      clearInterval(mtnState.jTimerInt);\n      // Reset journey nodes\n      for (var i = 1; i <= 6; i++) {\n        var node = document.getElementById('mtnN' + i);\n        if (node) node.style.opacity = '0.25';\n        var fill = document.querySelector('#mtnL' + i + ' .mtn-fill');\n        if (fill) fill.style.height = '0';\n        var badge = node ? node.querySelector('.mtn-badge') : null;\n        if (badge) badge.style.display = 'none';\n      }\n      document.getElementById('mtnArrivalBadge').style.display = 'none';\n      var card = document.getElementById('mtnN6Card');\n      card.style.background = 'transparent';\n      card.style.borderColor = '#334155';\n    }\n  </script>\n\n</div>",
