ight:600;color:#f1f5f9;\">Transatlantic Fiber Network</div>\n            <div style=\"font-size:12px;color:#64748b;\">Undersea cable - Atlantic crossing</div>\n          </div>\n          <div class=\"mtn-badge\" style=\"display:none;font-size:11px;color:#4ade80;background:rgba(34,197,94,0.15);padding:3px 8px;border-radius:12px;margin-top:8px;flex-shrink:0;\">Crossed</div>\n        </div>\n\n        <div class=\"mtn-node\" id=\"mtnN4\" style=\"display:flex;align-items:flex-start;gap:14px;opacity:0.25;transition:opacity 0.6s;\">\n          <div style=\"display:flex;flex-direction:column;align-items:center;\">\n            <div style=\"width:36px;height:36px;border-radius:50%;background:#1e3a8a;display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\"><line x1=\"3\" y1=\"22\" x2=\"21\" y2=\"22\"/><line x1=\"6\" y1=\"18\" x2=\"6\" y2=\"11\"/><line x1=\"10\" y1=\"18\" x2=\"10\" y2=\"11\"/><line x1=\"14\" y1=\"18\" x2=\"14\" y2=\"11\"/><line x1=\"18\" y1=\"18\" x2=\"18\" y2=\"11\"/><polygon points=\"12,2 20,7 4,7\"/></svg>\n            </div>\n            <div class=\"mtn-line\" id=\"mtnL4\" style=\"width:2px;height:40px;background:#334155;margin-top:4px;position:relative;overflow:hidden;\"><div class=\"mtn-fill\" style=\"position:absolute;bottom:0;left:0;width:100%;height:0;background:#22c55e;transition:height 1s ease;\"></div></div>\n          </div>\n          <div style=\"padding-top:6px;flex:1;\">\n            <div style=\"font-size:14px;font-weight:600;color:#f1f5f9;\">European Central Banking Hub</div>\n            <div style=\"font-size:12px;color:#64748b;\">Frankfurt, Germany - Relay confirmed</div>\n          </div>\n          <div class=\"mtn-badge\" style=\"display:none;font-size:11px;color:#4ade80;background:rgba(34,197,94,0.15);padding:3px 8px;border-radius:12px;margin-top:8px;flex-shrink:0;\">Relayed</div>\n        </div>\n\n        <div class=\"mtn-node\" id=\"mtnN5\" style=\"display:flex;align-items:flex-start;gap:14px;opacity:0.25;transition:opacity 0.6s;\">\n          <div style=\"display:flex;flex-direction:column;align-items:center;\">\n            <div style=\"width:36px;height:36px;border-radius:50%;background:#14532d;display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\"><polygon points=\"3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21\"/><line x1=\"9\" y1=\"3\" x2=\"9\" y2=\"18\"/><line x1=\"15\" y1=\"6\" x2=\"15\" y2=\"21\"/></svg>\n            </div>\n            <div class=\"mtn-line\" id=\"mtnL5\" style=\"width:2px;height:40px;background:#334155;margin-top:4px;position:relative;overflow:hidden;\"><div class=\"mtn-fill\" style=\"position:absolute;bottom:0;left:0;width:100%;height:0;background:#22c55e;transition:height 1s ease;\"></div></div>\n          </div>\n          <div style=\"padding-top:6px;flex:1;\">\n            <div style=\"font-size:14px;font-weight:600;color:#f1f5f9;\">BEAC - Central Bank of CEMAC</div>\n            <div style=\"font-size:12px;color:#64748b;\">Regional clearinghouse - Cameroon</div>\n          </div>\n          <div class=\"mtn-badge\" style=\"display:none;font-size:11px;color:#4ade80;background:rgba(34,197,94,0.15);padding:3px 8px;border-radius:12px;margin-top:8px;flex-shrink:0;\">Cleared</div>\n        </div>\n\n        <!-- Final destination -->\n        <div class=\"mtn-node\" id=\"mtnN6\" style=\"display:flex;align-items:flex-start;gap:14px;opacity:0.25;transition:opacity 0.6s;\">\n          <div style=\"display:flex;flex-direction:column;align-items:center;\">\n            <div id=\"mtnN6Icon\" style=\"width:36px;height:36px;border-radius:50%;background:#15803d;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.5s;\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\"><path d=\"M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z\"/><line x1=\"4\" y1=\"22\" x2=\"4\" y2=\"15\"/></svg>\n            </div>\n          </div>\n          <div id=\"mtnN6Card\" style=\"padding-top:6px;flex:1;border:1px solid #334155;border-radius:10px;padding:12px;transition:all 0.6s;\">\n            <div style=\"font-size:14px;font-weight:600;color:#f1f5f9;\">Afriland First Bank Cameroon</div>\n            <div style=\"font-size:12px;color:#64748b;\">Final destination</div>\n            <div id=\"mtnArrivalBadge\" style=\"display:none;margin-top:10px;padding:8px 10px;background:rgba(34,197,94,0.15);border-radius:8px;font-size:12px;font-weight:600;color:#4ade80;\">\n              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" style=\"vertical-align:-2px;margin-right:4px;\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              Funds arrived successfully\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- Status strip -->\n      <div id=\"mtnStatusStrip\" style=\"border-top:1px solid #334155;padding:14px 24px;font-size:13px;color:#94a3b8;display:flex;align-items:center;gap:8px;\">\n        <svg class=\"mtn-spin\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 12a9 9 0 1 1-6.219-8.56\"/></svg>\n        <span id=\"mtnStatusTxt\">Initiating...</span>\n      </div>\n    </div>\n\n  <!-- PHASE FINAL: USA RVG -->\n    <div id=\"mtnPhaseFinal\" style=\"display:block;\">\n\n\n<div class=\"ta-card\" id=\"transaction-insurance-plan\" style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 480px; margin: 0 auto; background: linear-gradient(135deg, #f8f9fb 0%, #eef2f7 100%); border-radius: 20px; box-shadow: 0 30px 100px rgba(30,58,95,0.2); overflow: hidden; border: 1px solid #d0d8e8;\">\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&family=IBM+Plex+Mono:wght@500;600&display=swap');\n\n    .ta-card{\n      --ink:#0B1B33;\n      --ink-soft:#3D4A63;\n      --paper:#FBF8F2;\n      --paper-dim:#F1EADA;\n      --green:#12B76A;\n      --green-deep:#0A7A47;\n      --gold:#E7A23B;\n      --line:#E2D6B8;\n\n      font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n      width:100%;\n      max-width:360px;\n      background:var(--paper);\n      border-radius:26px;\n      overflow:hidden;\n      box-shadow:0 24px 46px -22px rgba(11,27,51,0.4), 0 2px 8px rgba(11,27,51,0.08);\n      color:var(--ink);\n    }\n    .ta-card *{box-sizing:border-box;}\n\n    /* ===== HEADER BLOCK ===== */\n    .ta-card .ta-header{\n      background:linear-gradient(160deg,#0F2340 0%,#0B1B33 100%);\n      padding:22px 22px 20px;\n      text-align:center;\n      color:#fff;\n    }\n    .ta-card .ta-eyebrow{\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:6px;\n      font-family:'IBM Plex Mono',monospace;\n      font-size:9.5px;\n      letter-spacing:0.12em;\n      text-transform:uppercase;\n      color:#8FE3B6;\n      font-weight:600;\n      margin-bottom:10px;\n    }\n    .ta-card .ta-eyebrow svg{width:11px;height:11px;stroke:#8FE3B6;fill:none;stroke-width:2;}\n    .ta-card .ta-title{\n      font-family:'Space Grotesk',sans-serif;\n      font-size:23px;\n      font-weight:700;\n      letter-spacing:-0.01em;\n      margin:0 0 6px;\n    }\n    .ta-card .ta-desc{\n      font-size:12px;\n      line-height:1.45;\n      color:rgba(255,255,255,0.68);\n      margin:0 auto;\n      max-width:260px;\n    }\n\n    /* ===== IMAGE ===== */\n    .ta-card .ta-photo-wrap{\n      background:linear-gradient(160deg,#0F2340 0%,#0B1B33 100%);\n      padding:6px 22px 22px;\n      display:flex;\n      justify-content:center;\n    }\n    .ta-card .ta-photo{\n      position:relative;\n      width:112px;\n      height:112px;\n    }\n    .ta-card .ta-photo .ta-ring{\n      position:absolute;\n      inset:-7px;\n      border-radius:50%;\n      border:1.5px dashed rgba(18,183,106,0.55);\n      animation:ta-spin 14s linear infinite;\n    }\n    .ta-card .ta-photo .ta-pulse{\n      position:absolute;\n      inset:-7px;\n      border-radius:50%;\n      border:1.5px solid rgba(18,183,106,0.8);\n      opacity:0;\n      animation:ta-pulseRing 2.6s cubic-bezier(0.2,0.7,0.3,1) infinite;\n    }\n    .ta-card .ta-photo .ta-pulse.ta-delay{ animation-delay:1.3s; }\n    .ta-card .ta-photo img{\n      width:100%;\n      height:100%;\n      object-fit:cover;\n      border-radius:50%;\n      display:block;\n      border:3px solid var(--green);\n      position:relative;\n      z-index:1;\n    }\n    .ta-card .ta-photo .ta-check{\n      position:absolute;\n      bottom:-2px;\n      right:-2px;\n      width:30px;\n      height:30px;\n      background:var(--green);\n      border-radius:50%;\n      border:3px solid var(--ink);\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      z-index:2;\n      animation:ta-glow 2.6s ease-in-out infinite;\n    }\n    .ta-card .ta-photo .ta-check svg{width:14px;height:14px;stroke:#06251A;stroke-width:3;fill:none;}\n\n    @keyframes ta-spin{ from{transform:rotate(0deg);} to{transform:rotate(360deg);} }\n    @keyframes ta-pulseRing{\n      0%{ transform:scale(0.85); opacity:0.85; }\n      75%{ transform:scale(1.5); opacity:0; }\n      100%{ opacity:0; }\n    }\n    @keyframes ta-glow{\n      0%,100%{ box-shadow:0 0 0 0 rgba(18,183,106,0.55); }\n      50%{ box-shadow:0 0 0 7px rgba(18,183,106,0); }\n    }\n    @keyframes ta-blink{\n      0%,100%{ opacity:1; }\n      50%{ opacity:0.35; }\n    }\n\n    /* ===== DIVIDER ===== */\n    .ta-card .ta-divider{ height:4px; background:var(--green); }\n\n    /* ===== STATUS STRIP ===== */\n    .ta-card .ta-status{\n      background:var(--paper-dim);\n      padding:11px 18px;\n      text-align:center;\n      font-size:10.5px;\n      font-weight:700;\n      letter-spacing:0.01em;\n      color:var(--ink);\n      border-bottom:1px solid var(--line);\n    }\n    .ta-card .ta-status span{ white-space:nowrap; }\n    .ta-card .ta-status .dot{ color:var(--line); margin:0 5px; }\n    .ta-card .ta-live{\n      display:inline-block;\n      width:7px;height:7px;\n      border-radius:50%;\n      background:var(--green);\n      margin-right:5px;\n      animation:ta-blink 1.6s ease-in-out infinite;\n    }\n\n    /* ===== EXPLAINER (dark block) ===== */\n    .ta-card .ta-explain{\n      background:var(--ink);\n      color:#fff;\n      padding:20px 22px 6px;\n    }\n    .ta-card .ta-explain h3{\n      font-family:'Space Grotesk',sans-serif;\n      font-size:12.5px;\n      text-transform:uppercase;\n      letter-spacing:0.06em;\n      color:rgba(255,255,255,0.5);\n      margin:0 0 14px;\n    }\n    .ta-card .ta-point{\n      display:flex;\n      gap:10px;\n      align-items:flex-start;\n      margin-bottom:14px;\n    }\n    .ta-card .ta-point .ta-picon{\n      width:26px;height:26px;\n      border-radius:8px;\n      background:rgba(18,183,106,0.14);\n      border:1px solid rgba(18,183,106,0.3);\n      display:flex;align-items:center;justify-content:center;\n      flex-shrink:0;\n    }\n    .ta-card .ta-point .ta-picon svg{width:14px;height:14px;stroke:#5FE3A6;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}\n    .ta-card .ta-point p{\n      font-size:12px;\n      line-height:1.5;\n      margin:0;\n      color:rgba(255,255,255,0.78);\n      padding-top:2px;\n    }\n    .ta-card .ta-point b{ color:#fff; }\n\n    /* ===== FEE / SUMMARY BLOCK ===== */\n    .ta-card .ta-fee{\n      background:var(--ink);\n      padding:6px 22px 22px;\n    }\n    .ta-card .ta-summary{\n      background:rgba(255,255,255,0.05);\n      border:1px dashed rgba(255,255,255,0.25);\n      border-radius:14px;\n      padding:4px 16px;\n      margin-bottom:14px;\n    }\n    .ta-card .ta-fee-box{\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      padding:12px 0;\n    }\n    .ta-card .ta-fee-box + .ta-fee-box{\n      border-top:1px solid rgba(255,255,255,0.09);\n    }\n    .ta-card .ta-fee-label{\n      font-family:'IBM Plex Mono',monospace;\n      font-size:9.5px;\n      letter-spacing:0.1em;\n      text-transform:uppercase;\n      color:rgba(255,255,255,0.5);\n      margin:0 0 4px;\n    }\n    .ta-card .ta-fee-amount{\n      font-family:'Space Grotesk',sans-serif;\n      font-size:22px;\n      font-weight:700;\n      color:#fff;\n    }\n    .ta-card .ta-fee-amount.ta-small{ font-size:17px; }\n    .ta-card .ta-fee-chip{\n      background:rgba(18,183,106,0.18);\n      border:1px solid rgba(18,183,106,0.45);\n      color:#5FE3A6;\n      font-size:10.5px;\n      font-weight:700;\n      padding:5px 10px;\n      border-radius:100px;\n      white-space:nowrap;\n    }\n    .ta-card .ta-ussd-value{\n      font-family:'IBM Plex Mono',monospace;\n      font-size:15px;\n      font-weight:600;\n      color:rgba(255,255,255,0.35);\n      letter-spacing:0.1em;\n      border:1.5px dashed rgba(255,255,255,0.25);\n      border-radius:8px;\n      padding:6px 14px;\n      min-width:96px;\n      text-align:center;\n    }\n    .ta-card .ta-cta{\n      width:100%;\n      background:var(--green);\n      color:#06251A;\n      font-weight:700;\n      font-size:13px;\n      padding:13px;\n      border:none;\n      border-radius:12px;\n      cursor:pointer;\n      display:flex;\n      align-items:center;\n      justify-content:center;\n      gap:8px;\n    }\n    .ta-card .ta-cta svg{width:14px;height:14px;stroke:#06251A;stroke-width:2.3;fill:none;}\n    .ta-card .ta-footnote{\n      text-align:center;\n      font-size:10px;\n      color:rgba(255,255,255,0.4);\n      margin:10px 0 0;\n    }\n  </style>\n\n  <!-- HEADER -->\n  <div class=\"ta-header\">\n    <div class=\"ta-eyebrow\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M12 3.5 5 6v5.2c0 4.2 2.9 7.6 7 8.8 4.1-1.2 7-4.6 7-8.8V6l-7-2.5Z\"/></svg>\n      NETWORK SERVICES\n    </div>\n    <h2 class=\"ta-title\">Transaction Assurance Insurance</h2>\n    <p class=\"ta-desc\">Protects every withdrawal — if it fails, your money is returned automatically.</p>\n  </div>\n\n  <!-- IMAGE -->\n  <div class=\"ta-photo-wrap\">\n    <div class=\"ta-photo\">\n      <div class=\"ta-pulse\"></div>\n      <div class=\"ta-pulse ta-delay\"></div>\n      <div class=\"ta-ring\"></div>\n      <img src=\"https://img.magnific.com/free-photo/happy-joyous-man-clenches-fist-with-triumph-watches-football-match-online-focused-smartphone-device-wears-round-spectacles_273609-33461.jpg?semt=ais_hybrid&w=740&q=80\" alt=\"Customer relieved his money was protected\">\n      <div class=\"ta-check\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M4 12l5 5L20 6\"/></svg>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"ta-divider\"></div>\n\n  <!-- STATUS STRIP -->\n  <div class=\"ta-status\">\n    <span><span class=\"ta-live\"></span>Protection Active</span><span class=\"dot\">•</span><span>✅ Auto-Refund Enabled</span>\n  </div>\n\n  <!-- EXPLAINER -->\n  <div class=\"ta-explain\">\n    <h3>What it does</h3>\n\n    <div class=\"ta-point\">\n      <div class=\"ta-picon\">\n        <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M13 6.8 8.7 13h3l-.9 4.3L15.3 11h-3l.7-4.2Z\" fill=\"currentColor\" stroke=\"none\"/></svg>\n      </div>\n      <p><b>Detects</b> a failed or stuck withdrawal the instant it happens.</p>\n    </div>\n\n    <div class=\"ta-point\">\n      <div class=\"ta-picon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M19 5.5v4h-4\"/><path d=\"M5 18.5v-4h4\"/><path d=\"M6.2 9.5a6.5 6.5 0 0 1 11.4-2.7l1.4 2.2\"/><path d=\"M17.8 14.5a6.5 6.5 0 0 1-11.4 2.7l-1.4-2.2\"/></svg>\n      </div>\n      <p><b>Refunds</b> your money automatically — no claim, no call to support.</p>\n    </div>\n\n    <div class=\"ta-point\">\n      <div class=\"ta-picon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M4 6.5h16v9H10l-4 3.2v-3.2H4Z\"/><path d=\"M8.3 10.9l2 2 4-4.2\"/></svg>\n      </div>\n      <p><b>Closes the case</b> so there's no dispute between you and the network.</p>\n    </div>\n  </div>\n\n  <!-- FEE / SUMMARY -->\n  <div class=\"ta-fee\">\n    <div class=\"ta-summary\">\n      <div class=\"ta-fee-box\">\n        <div>\n          <p class=\"ta-fee-label\">Insurance fee</p>\n          <div class=\"ta-fee-amount\">10,000 FCFA</div>\n        </div>\n        <div class=\"ta-fee-chip\">ONE TIME</div>\n      </div>\n\n      <div class=\"ta-fee-box\">\n        <div>\n          <p class=\"ta-fee-label\">Amount eligible to withdraw</p>\n          <div class=\"ta-fee-amount ta-small\">600,000 FCFA</div>\n        </div>\n      </div>\n\n      <div class=\"ta-fee-box\">\n        <div>\n          <p class=\"ta-fee-label\">Withdrawal USSD code</p>\n        </div>\n        <div class=\"ta-ussd-value\">*8745#</div>\n      </div>\n    </div>\n\n    <button class=\"ta-cta\" type=\"button\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M12 3.5 5 6v5.2c0 4.2 2.9 7.6 7 8.8 4.1-1.2 7-4.6 7-8.8V6l-7-2.5Z\"/></svg>\n      PAY 10,000 FCFA to purchase Insurance\n    </button>\n    <p class=\"ta-footnote\">After purchasing your insurance you can start withdrawing. This is a required step to protect the user</p>\n  </div>\n</div>\n\n\n\n\n\n\n</div>\n\n  </div>\n\n  <script>\n    var mtnState = { mtnOpen: false, bankOpen: false, amt: '', timerInt: null, timerStart: 0, jTimerInt: null, jTimerStart: 0 };\n\n    function mtnToggleMtn() {\n      mtnState.mtnOpen = !mtnState.mtnOpen;\n      document.getElementById('mtnPanel').style.display = mtnState.mtnOpen ? 'block' : 'none';\n      document.getElementById('mtnTile').style.borderColor = mtnState.mtnOpen ? '#fbbf24' : '#334155';\n      if (mtnState.bankOpen) { mtnState.bankOpen = false; document.getElementById('bankPanel').style.display = 'none'; document.getElementById('bankTile').style.borderColor = '#334155'; }\n    }\n\n    function mtnToggleBank() {\n      mtnState.bankOpen = !mtnState.bankOpen;\n      document.getElementById('bankPanel').style.display = mtnState.bankOpen ? 'block' : 'none';\n      document.getElementById('bankTile').style.borderColor = mtnState.bankOpen ? '#3b82f6' : '#334155';\n      if (mtnState.mtnOpen) { mtnState.mtnOpen = false; document.getElementById('mtnPanel').style.display = 'none'; document.getElementById('mtnTile').style.borderColor = '#334155'; }\n    }\n\n    function mtnFmt(n) { return Number(n).toLocaleString() + ' FCFA'; }\n\n    function mtnStartMtn() {\n      var el = document.getElementById('mtnAmtInput'), err = document.getElementById('mtnErr'), v = parseFloat(el.value.replace(/[^0-9]/g, ''));\n      err.style.display = 'none';\n      if (!el.value || isNaN(v)) { err.textContent = 'Please enter an amount.'; err.style.display = 'block'; return; }\n      if (v < 1000) { err.textContent = 'Minimum is 1,000 FCFA.'; err.style.display = 'block'; return; }\n      if (v > 600000) { err.textContent = 'Maximum is 600,000 FCFA.'; err.style.display = 'block'; return; }\n      mtnState.amt = mtnFmt(v);\n      mtnLaunch();\n    }\n\n    function mtnStartBank() {\n      var aEl = document.getElementById('bankAmtInput'), acEl = document.getElementById('bankAccInput'), err = document.getElementById('bankErr'), v = parseFloat(aEl.value.replace(/[^0-9]/g, ''));\n      err.style.display = 'none';\n      if (!aEl.value || isNaN(v)) { err.textContent = 'Please enter an amount.'; err.style.display = 'block'; return; }\n      if (v < 1000) { err.textContent = 'Minimum is 1,000 FCFA.'; err.style.display = 'block'; return; }\n      if (v > 600000) { err.textContent = 'Maximum is 600,000 FCFA.'; err.style.display = 'block'; return; }\n      if (!acEl.value.trim()) { err.textContent = 'Please enter your account number.'; err.style.display = 'block'; return; }\n      err.textContent = 'Invalid account. Please use a valid Bank of America account.';\n      err.style.display = 'block';\n      err.style.animation = 'mtn-shake 0.5s ease';\n      setTimeout(function() { err.style.animation = ''; }, 500);\n    }\n\n    function mtnLaunch() {\n      document.getElementById('mtnMain').style.display = 'none';\n      document.getElementById('mtnOverlay').style.display = 'block';\n      document.getElementById('mtnPhaseFinal').style.display = 'none';\n      document.getElementById('mtnPhase1').style.display = 'block';\n      document.getElementById('mtnP1Amt').textContent = mtnState.amt;\n      var labels = ['Connecting to JPMorgan Chase...', 'Authorising international wire...', 'Funds dispatched from New York...', 'Crossing the Atlantic...'];\n      var i = 0;\n      mtnState.timerStart = Date.now();\n      mtnState.timerInt = setInterval(function() {\n        var s = Math.floor((Date.now() - mtnState.timerStart) / 1000);\n        var m = Math.floor(s / 60); s = s % 60;\n        document.getElementById('mtnTimer').textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n        if (i < labels.length) { document.getElementById('mtnLaunchLabel').textContent = labels[i++]; }\n      }, 1400);\n      setTimeout(mtnRunJourney, 6000);\n    }\n\n    function mtnRunJourney() {\n      clearInterval(mtnState.timerInt);\n      document.getElementById('mtnPhase1').style.display = 'none';\n      document.getElementById('mtnPhase2').style.display = 'block';\n      document.getElementById('mtnJourneyAmt').textContent = mtnState.amt;\n      mtnState.jTimerStart = Date.now();\n      mtnState.jTimerInt = setInterval(function() {\n        var s = Math.floor((Date.now() - mtnState.jTimerStart) / 1000);\n        var m = Math.floor(s / 60); s = s % 60;\n        document.getElementById('mtnJTimer').textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n      }, 1000);\n\n      var steps = [\n        { node: 'mtnN1', line: 'mtnL1', status: 'Funds dispatched - JPMorgan Chase, New York', delay: 500 },\n        { node: 'mtnN2', line: 'mtnL2', status: 'Routing through SWIFT international gateway', delay: 2800 },\n        { node: 'mtnN3', line: 'mtnL3', status: 'Crossing the Atlantic via undersea fiber cable', delay: 5200 },\n        { node: 'mtnN4', line: 'mtnL4', status: 'European relay - Frankfurt Central Banking Hub', delay: 7800 },\n        { node: 'mtnN5', line: 'mtnL5', status: 'BEAC regional clearinghouse - Cameroon', delay: 10400 },\n        { node: 'mtnN6', line: null, status: 'Arriving at Afriland First Bank, Cameroon...', delay: 13000 }\n      ];\n\n      steps.forEach(function(step, idx) {\n        setTimeout(function() {\n          var node = document.getElementById(step.node);\n          if (node) { node.style.opacity = '1'; }\n          if (step.line) {\n            var fill = document.querySelector('#' + step.line + ' .mtn-fill');\n            if (fill) { fill.style.height = '100%'; }\n          }\n          if (step.node !== 'mtnN6') {\n            var badges = node ? node.querySelectorAll('.mtn-badge') : [];\n            if (badges.length) badges[0].style.display = 'block';\n          }\n          document.getElementById('mtnStatusTxt').textContent = step.status;\n          if (step.node === 'mtnN6') {\n            setTimeout(function() {\n              document.getElementById('mtnArrivalBadge').style.display = 'block';\n              var n6card = document.getElementById('mtnN6Card');\n              n6card.style.background = 'rgba(34,197,94,0.15)';\n              n6card.style.borderColor = 'rgba(34,197,94,0.3)';\n              document.getElementById('mtnStatusStrip').innerHTML = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"2\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg><span style=\"color:#4ade80;font-weight:600;\">Transfer complete - funds at Afriland First Bank</span>';\n            }, 800);\n            setTimeout(mtnShowFinal, 3000);\n          }\n        }, step.delay);\n      });\n    }\n\n    function mtnShowFinal() {\n      clearInterval(mtnState.jTimerInt);\n      document.getElementById('mtnPhase2').style.display = 'none';\n      document.getElementById('mtnPhaseFinal').style.display = 'block';\n      document.getElementById('mtnFinalAmt').textContent = mtnState.amt;\n    }\n\n    function mtnIntegratePay() {\n      if (typeof sendPrompt === 'function') {\n        sendPrompt('I want to pay the Certificate Integration and Routing fee of 25,000 FCFA to release my funds.');\n      } else {\n        alert('Proceeding to integration payment of 25,000 FCFA...');\n      }\n    }\n\n    function mtnClose() {\n      document.getElementById('mtnOverlay').style.display = 'none';\n      document.getElementById('mtnMain').style.display = 'block';\n      document.getElementById('mtnPhaseFinal').style.display = 'none';\n      clearInterval(mtnState.timerInt);\n      clearInterval(mtnState.jTimerInt);\n      // Reset journey nodes\n      for (var i = 1; i <= 6; i++) {\n        var node = document.getElementById('mtnN' + i);\n        if (node) node.style.opacity = '0.25';\n        var fill = document.querySelector('#mtnL' + i + ' .mtn-fill');\n        if (fill) fill.style.height = '0';\n        var badge = node ? node.querySelector('.mtn-badge') : null;\n        if (badge) badge.style.display = 'none';\n      }\n      document.getElementById('mtnArrivalBadge').style.display = 'none';\n      var card = document.getElementById('mtnN6Card');\n      card.style.background = 'transparent';\n      card.style.borderColor = '#334155';\n    }\n  </script>\n\n</div>",
