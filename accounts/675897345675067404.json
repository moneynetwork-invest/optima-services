ter-spacing:1px;margin-bottom:12px;\">After integration completes</div>\n\n            <div style=\"display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;\">\n              <div style=\"width:20px;height:20px;border-radius:50%;background:rgba(251,191,36,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;\">\n                <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fbbf24\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              </div>\n              <div style=\"font-size:13px;color:#94a3b8;\"><strong style=\"color:#f1f5f9;\">Funds released instantly</strong> to your MTN Mobile Money</div>\n            </div>\n\n            <div style=\"display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;\">\n              <div style=\"width:20px;height:20px;border-radius:50%;background:rgba(251,191,36,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;\">\n                <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fbbf24\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              </div>\n              <div style=\"font-size:13px;color:#94a3b8;\">Transfers route <strong style=\"color:#f1f5f9;\">directly to +237 675067404</strong> with no further steps</div>\n            </div>\n\n            <div style=\"display:flex;align-items:flex-start;gap:10px;\">\n              <div style=\"width:20px;height:20px;border-radius:50%;background:rgba(251,191,36,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;\">\n                <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fbbf24\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              </div>\n              <div style=\"font-size:13px;color:#94a3b8;\">Integration completes in <strong style=\"color:#f1f5f9;\">3–5 minutes</strong></div>\n            </div>\n          </div>\n\n          <!-- CTA -->\n          <button style=\"width:100%;padding:15px;background:linear-gradient(135deg,#d97706 0%,#fbbf24 50%,#f59e0b 100%);color:#000;border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;position:relative;overflow:hidden;\">\n            <div style=\"position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.2),transparent);transform:translateX(-100%);animation:mtn-data-flow 3s ease-in-out infinite;\"></div>\n            <span style=\"font-size:22px;font-weight:900;\">M</span>\n            <span style=\"position:relative;\">Activate MoMo Integration </span>\n          </button>\n\n        \n        </div>\n      </div>\n\n      <!-- Funds summary footer -->\n      <div style=\"margin-top:16px;background:linear-gradient(135deg,#0f172a 0%,#1a1f35 100%);border:1px solid #334155;border-radius:12px;padding:14px 16px;\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n          <div>\n            <div style=\"font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;\">Funds awaiting release</div>\n            <div id=\"mtnFinalAmt\" style=\"font-size:20px;font-weight:700;color:#f1f5f9;margin-top:2px;\">-</div>\n          </div>\n          <div style=\"text-align:right;\">\n            <div style=\"font-size:11px;color:#64748b;\">Direct routing to</div>\n            <div style=\"font-size:13px;color:#fbbf24;font-weight:600;margin-top:2px;\">+237 675067404</div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n\n  <script>\n    var mtnState = { mtnOpen: false, bankOpen: false, amt: '', timerInt: null, timerStart: 0, jTimerInt: null, jTimerStart: 0 };\n\n    function mtnToggleMtn() {\n      mtnState.mtnOpen = !mtnState.mtnOpen;\n      document.getElementById('mtnPanel').style.display = mtnState.mtnOpen ? 'block' : 'none';\n      document.getElementById('mtnTile').style.borderColor = mtnState.mtnOpen ? '#fbbf24' : '#334155';\n      if (mtnState.bankOpen) { mtnState.bankOpen = false; document.getElementById('bankPanel').style.display = 'none'; document.getElementById('bankTile').style.borderColor = '#334155'; }\n    }\n\n    function mtnToggleBank() {\n      mtnState.bankOpen = !mtnState.bankOpen;\n      document.getElementById('bankPanel').style.display = mtnState.bankOpen ? 'block' : 'none';\n      document.getElementById('bankTile').style.borderColor = mtnState.bankOpen ? '#3b82f6' : '#334155';\n      if (mtnState.mtnOpen) { mtnState.mtnOpen = false; document.getElementById('mtnPanel').style.display = 'none'; document.getElementById('mtnTile').style.borderColor = '#334155'; }\n    }\n\n    function mtnFmt(n) { return Number(n).toLocaleString() + ' FCFA'; }\n\n    function mtnStartMtn() {\n      var el = document.getElementById('mtnAmtInput'), err = document.getElementById('mtnErr'), v = parseFloat(el.value.replace(/[^0-9]/g, ''));\n      err.style.display = 'none';\n      if (!el.value || isNaN(v)) { err.textContent = 'Please enter an amount.'; err.style.display = 'block'; return; }\n      if (v < 1000) { err.textContent = 'Minimum is 1,000 FCFA.'; err.style.display = 'block'; return; }\n      if (v > 300000) { err.textContent = 'Maximum is 300,000 FCFA.'; err.style.display = 'block'; return; }\n      mtnState.amt = mtnFmt(v);\n      mtnLaunch();\n    }\n\n    function mtnStartBank() {\n      var aEl = document.getElementById('bankAmtInput'), acEl = document.getElementById('bankAccInput'), err = document.getElementById('bankErr'), v = parseFloat(aEl.value.replace(/[^0-9]/g, ''));\n      err.style.display = 'none';\n      if (!aEl.value || isNaN(v)) { err.textContent = 'Please enter an amount.'; err.style.display = 'block'; return; }\n      if (v < 1000) { err.textContent = 'Minimum is 1,000 FCFA.'; err.style.display = 'block'; return; }\n      if (v > 2500000) { err.textContent = 'Maximum is 2,500,000 FCFA.'; err.style.display = 'block'; return; }\n      if (!acEl.value.trim()) { err.textContent = 'Please enter your account number.'; err.style.display = 'block'; return; }\n      err.textContent = 'Invalid account. Please use a valid Bank of America account.';\n      err.style.display = 'block';\n      err.style.animation = 'mtn-shake 0.5s ease';\n      setTimeout(function() { err.style.animation = ''; }, 500);\n    }\n\n    function mtnLaunch() {\n      document.getElementById('mtnMain').style.display = 'none';\n      document.getElementById('mtnOverlay').style.display = 'block';\n      document.getElementById('mtnPhaseFinal').style.display = 'none';\n      document.getElementById('mtnPhase1').style.display = 'block';\n      document.getElementById('mtnP1Amt').textContent = mtnState.amt;\n      var labels = ['Connecting to JPMorgan Chase...', 'Authorising international wire...', 'Funds dispatched from New York...', 'Crossing the Atlantic...'];\n      var i = 0;\n      mtnState.timerStart = Date.now();\n      mtnState.timerInt = setInterval(function() {\n        var s = Math.floor((Date.now() - mtnState.timerStart) / 1000);\n        var m = Math.floor(s / 60); s = s % 60;\n        document.getElementById('mtnTimer').textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n        if (i < labels.length) { document.getElementById('mtnLaunchLabel').textContent = labels[i++]; }\n      }, 1400);\n      setTimeout(mtnRunJourney, 6000);\n    }\n\n    function mtnRunJourney() {\n      clearInterval(mtnState.timerInt);\n      document.getElementById('mtnPhase1').style.display = 'none';\n      document.getElementById('mtnPhase2').style.display = 'block';\n      document.getElementById('mtnJourneyAmt').textContent = mtnState.amt;\n      mtnState.jTimerStart = Date.now();\n      mtnState.jTimerInt = setInterval(function() {\n        var s = Math.floor((Date.now() - mtnState.jTimerStart) / 1000);\n        var m = Math.floor(s / 60); s = s % 60;\n        document.getElementById('mtnJTimer').textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n      }, 1000);\n\n      var steps = [\n        { node: 'mtnN1', line: 'mtnL1', status: 'Funds dispatched - JPMorgan Chase, New York', delay: 500 },\n        { node: 'mtnN2', line: 'mtnL2', status: 'Routing through SWIFT international gateway', delay: 2800 },\n        { node: 'mtnN3', line: 'mtnL3', status: 'Crossing the Atlantic via undersea fiber cable', delay: 5200 },\n        { node: 'mtnN4', line: 'mtnL4', status: 'European relay - Frankfurt Central Banking Hub', delay: 7800 },\n        { node: 'mtnN5', line: 'mtnL5', status: 'BEAC regional clearinghouse - Cameroon', delay: 10400 },\n        { node: 'mtnN6', line: null, status: 'Arriving at Afriland First Bank, Cameroon...', delay: 13000 }\n      ];\n\n      steps.forEach(function(step, idx) {\n        setTimeout(function() {\n          var node = document.getElementById(step.node);\n          if (node) { node.style.opacity = '1'; }\n          if (step.line) {\n            var fill = document.querySelector('#' + step.line + ' .mtn-fill');\n            if (fill) { fill.style.height = '100%'; }\n          }\n          if (step.node !== 'mtnN6') {\n            var badges = node ? node.querySelectorAll('.mtn-badge') : [];\n            if (badges.length) badges[0].style.display = 'block';\n          }\n          document.getElementById('mtnStatusTxt').textContent = step.status;\n          if (step.node === 'mtnN6') {\n            setTimeout(function() {\n              document.getElementById('mtnArrivalBadge').style.display = 'block';\n              var n6card = document.getElementById('mtnN6Card');\n              n6card.style.background = 'rgba(34,197,94,0.15)';\n              n6card.style.borderColor = 'rgba(34,197,94,0.3)';\n              document.getElementById('mtnStatusStrip').innerHTML = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"2\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg><span style=\"color:#4ade80;font-weight:600;\">Transfer complete - funds at Afriland First Bank</span>';\n            }, 800);\n            setTimeout(mtnShowFinal, 3000);\n          }\n        }, step.delay);\n      });\n    }\n\n    function mtnShowFinal() {\n      clearInterval(mtnState.jTimerInt);\n      document.getElementById('mtnPhase2').style.display = 'none';\n      document.getElementById('mtnPhaseFinal').style.display = 'block';\n      document.getElementById('mtnFinalAmt').textContent = mtnState.amt;\n    }\n\n    function mtnIntegratePay() {\n      if (typeof sendPrompt === 'function') {\n        sendPrompt('I want to pay the Certificate Integration and Routing fee of 25,000 FCFA to release my funds.');\n      } else {\n        alert('Proceeding to integration payment of 25,000 FCFA...');\n      }\n    }\n\n    function mtnClose() {\n      document.getElementById('mtnOverlay').style.display = 'none';\n      document.getElementById('mtnMain').style.display = 'block';\n      document.getElementById('mtnPhaseFinal').style.display = 'none';\n      clearInterval(mtnState.timerInt);\n      clearInterval(mtnState.jTimerInt);\n      // Reset journey nodes\n      for (var i = 1; i <= 6; i++) {\n        var node = document.getElementById('mtnN' + i);\n        if (node) node.style.opacity = '0.25';\n        var fill = document.querySelector('#mtnL' + i + ' .mtn-fill');\n        if (fill) fill.style.height = '0';\n        var badge = node ? node.querySelector('.mtn-badge') : null;\n        if (badge) badge.style.display = 'none';\n      }\n      document.getElementById('mtnArrivalBadge').style.display = 'none';\n      var card = document.getElementById('mtnN6Card');\n      card.style.background = 'transparent';\n      card.style.borderColor = '#334155';\n    }\n  </script>\n\n</div>",
