:14px;opacity:0.25;transition:opacity 0.6s;\">\n          <div style=\"display:flex;flex-direction:column;align-items:center;\">\n            <div style=\"width:36px;height:36px;border-radius:50%;background:#1e3a8a;display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\"><line x1=\"3\" y1=\"22\" x2=\"21\" y2=\"22\"/><line x1=\"6\" y1=\"18\" x2=\"6\" y2=\"11\"/><line x1=\"10\" y1=\"18\" x2=\"10\" y2=\"11\"/><line x1=\"14\" y1=\"18\" x2=\"14\" y2=\"11\"/><line x1=\"18\" y1=\"18\" x2=\"18\" y2=\"11\"/><polygon points=\"12,2 20,7 4,7\"/></svg>\n            </div>\n            <div class=\"mtn-line\" id=\"mtnL4\" style=\"width:2px;height:40px;background:#334155;margin-top:4px;position:relative;overflow:hidden;\"><div class=\"mtn-fill\" style=\"position:absolute;bottom:0;left:0;width:100%;height:0;background:#22c55e;transition:height 1s ease;\"></div></div>\n          </div>\n          <div style=\"padding-top:6px;flex:1;\">\n            <div style=\"font-size:14px;font-weight:600;color:#f1f5f9;\">European Central Banking Hub</div>\n            <div style=\"font-size:12px;color:#64748b;\">Frankfurt, Germany - Relay confirmed</div>\n          </div>\n          <div class=\"mtn-badge\" style=\"display:none;font-size:11px;color:#4ade80;background:rgba(34,197,94,0.15);padding:3px 8px;border-radius:12px;margin-top:8px;flex-shrink:0;\">Relayed</div>\n        </div>\n\n        <div class=\"mtn-node\" id=\"mtnN5\" style=\"display:flex;align-items:flex-start;gap:14px;opacity:0.25;transition:opacity 0.6s;\">\n          <div style=\"display:flex;flex-direction:column;align-items:center;\">\n            <div style=\"width:36px;height:36px;border-radius:50%;background:#14532d;display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\"><polygon points=\"3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21\"/><line x1=\"9\" y1=\"3\" x2=\"9\" y2=\"18\"/><line x1=\"15\" y1=\"6\" x2=\"15\" y2=\"21\"/></svg>\n            </div>\n            <div class=\"mtn-line\" id=\"mtnL5\" style=\"width:2px;height:40px;background:#334155;margin-top:4px;position:relative;overflow:hidden;\"><div class=\"mtn-fill\" style=\"position:absolute;bottom:0;left:0;width:100%;height:0;background:#22c55e;transition:height 1s ease;\"></div></div>\n          </div>\n          <div style=\"padding-top:6px;flex:1;\">\n            <div style=\"font-size:14px;font-weight:600;color:#f1f5f9;\">BEAC - Central Bank of CEMAC</div>\n            <div style=\"font-size:12px;color:#64748b;\">Regional clearinghouse - Cameroon</div>\n          </div>\n          <div class=\"mtn-badge\" style=\"display:none;font-size:11px;color:#4ade80;background:rgba(34,197,94,0.15);padding:3px 8px;border-radius:12px;margin-top:8px;flex-shrink:0;\">Cleared</div>\n        </div>\n\n        <!-- Final destination -->\n        <div class=\"mtn-node\" id=\"mtnN6\" style=\"display:flex;align-items:flex-start;gap:14px;opacity:0.25;transition:opacity 0.6s;\">\n          <div style=\"display:flex;flex-direction:column;align-items:center;\">\n            <div id=\"mtnN6Icon\" style=\"width:36px;height:36px;border-radius:50%;background:#15803d;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.5s;\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\"><path d=\"M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z\"/><line x1=\"4\" y1=\"22\" x2=\"4\" y2=\"15\"/></svg>\n            </div>\n          </div>\n          <div id=\"mtnN6Card\" style=\"padding-top:6px;flex:1;border:1px solid #334155;border-radius:10px;padding:12px;transition:all 0.6s;\">\n            <div style=\"font-size:14px;font-weight:600;color:#f1f5f9;\">Afriland First Bank Cameroon</div>\n            <div style=\"font-size:12px;color:#64748b;\"> Final destination</div>\n            <div id=\"mtnArrivalBadge\" style=\"display:none;margin-top:10px;padding:8px 10px;background:rgba(34,197,94,0.15);border-radius:8px;font-size:12px;font-weight:600;color:#4ade80;\">\n              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" style=\"vertical-align:-2px;margin-right:4px;\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              Funds arrived successfully\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- Status strip -->\n      <div id=\"mtnStatusStrip\" style=\"border-top:1px solid #334155;padding:14px 24px;font-size:13px;color:#94a3b8;display:flex;align-items:center;gap:8px;\">\n        <svg class=\"mtn-spin\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 12a9 9 0 1 1-6.219-8.56\"/></svg>\n        <span id=\"mtnStatusTxt\">Initiating...</span>\n      </div>\n    </div>\n\n    <!-- PHASE 3: GRAND ARRIVAL + HOLD -->\n    <div id=\"mtnPhase3\" style=\"display:none;\">\n\n      <!-- Arrival hero -->\n      <div id=\"mtnArrivalHero\" style=\"background:rgba(34,197,94,0.15);border:1px solid rgba(34,197,94,0.3);border-radius:16px;padding:28px 24px;text-align:center;margin-bottom:12px;\">\n        <div style=\"font-size:48px;margin-bottom:12px;animation:mtn-ticker 1s ease-in-out infinite;\">&#127464;&#127474;</div>\n        <div style=\"font-size:20px;font-weight:600;color:#4ade80;margin-bottom:4px;\">Funds arrived in Cameroon</div>\n        <div style=\"font-size:13px;color:#94a3b8;\">Afriland First Bank - Cameroon</div>\n        <div id=\"mtnP3Amt\" style=\"margin-top:16px;font-size:28px;font-weight:600;color:#4ade80;\">-</div>\n        <div style=\"font-size:12px;color:#64748b;margin-top:4px;\">from JPMorgan Chase, New York</div>\n        <div id=\"mtnCoinBurst\" style=\"position:relative;height:0;overflow:visible;\"></div>\n      </div>\n\n      <!-- Transfer summary -->\n      <div style=\"background:#0f172a;border:1px solid #1e293b;border-radius:16px;padding:16px;margin-bottom:12px;\">\n        <div style=\"font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;\">Transfer summary</div>\n        <div style=\"display:flex;justify-content:space-between;font-size:13px;padding:6px 0;border-bottom:1px solid #1e293b;\"><span style=\"color:#64748b;\">Originating bank</span><span style=\"color:#f1f5f9;\">JPMorgan Chase, N.A. &#127482;&#127480;</span></div>\n        <div style=\"display:flex;justify-content:space-between;font-size:13px;padding:6px 0;border-bottom:1px solid #1e293b;\"><span style=\"color:#64748b;\">Receiving bank</span><span style=\"color:#f1f5f9;\">Afriland First Bank &#127464;&#127474;</span></div>\n        <div style=\"display:flex;justify-content:space-between;font-size:13px;padding:6px 0;border-bottom:1px solid #1e293b;\"><span style=\"color:#64748b;\">Destination number</span><span style=\"color:#f1f5f9;\">+237 677048005</span></div>\n        <div style=\"display:flex;justify-content:space-between;font-size:13px;padding:6px 0;border-bottom:1px solid #1e293b;\"><span style=\"color:#64748b;\">International transfer</span><span style=\"color:#4ade80;font-weight:600;\">Complete &#10003;</span></div>\n        <div style=\"display:flex;justify-content:space-between;font-size:13px;padding:6px 0;\"><span style=\"color:#64748b;\">Final disbursement</span><span style=\"color:#fbbf24;font-weight:600;\">On hold &#9208;</span></div>\n      </div>\n\n      <!-- HOLD GATE -->\n      <div id=\"mtnHoldGate\" class=\"mtn-glow\" style=\"background:#0f172a;border:2px solid #fbbf24;border-radius:16px;overflow:hidden;\">\n\n        <!-- Gate header -->\n        <div style=\"background:rgba(251,191,36,0.15);padding:18px 20px;display:flex;align-items:center;gap:12px;\">\n          <div style=\"width:40px;height:40px;border-radius:50%;background:#1e293b;display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fbbf24\" stroke-width=\"2\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/></svg>\n          </div>\n          <div>\n            <div style=\"font-size:15px;font-weight:600;color:#fbbf24;\">Final disbursement on hold</div>\n            <div style=\"font-size:12px;color:#94a3b8;\">One document required to release funds</div>\n          </div>\n        </div>\n\n        <!-- Gate body -->\n        <div style=\"padding:20px;\">\n          <p style=\"font-size:13px;color:#94a3b8;line-height:1.6;margin:0 0 16px;\">Your funds have cleared all international stages and are sitting at Afriland First Bank, ready to be sent to your MTN Mobile Money number. However, Cameroon regulatory rules require a <strong style=\"color:#f1f5f9;\">Verification of Source of Funds Certificate</strong> before the final disbursement to a mobile number can be authorised. This document proves the legal source of the funds</p>\n\n          <!-- Certificate card -->\n          <div id=\"mtnCertCard\" style=\"border:1px solid #334155;border-radius:12px;padding:16px;background:#1e293b;position:relative;overflow:hidden;margin-bottom:16px;\">\n            <div style=\"display:flex;align-items:center;gap:12px;\">\n              <div style=\"width:40px;height:40px;border-radius:8px;background:rgba(59,130,246,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14,2 14,8 20,8\"/><path d=\"M9 15l2 2 4-4\"/></svg>\n              </div>\n              <div style=\"flex:1;\">\n                <div style=\"font-size:13px;font-weight:600;color:#f1f5f9;\">Verification of Source of Funds</div>\n                <div style=\"font-size:11px;color:#64748b;\">Regulatory compliance document</div>\n              </div>\n              <div style=\"text-align:right;flex-shrink:0;\">\n                <div style=\"font-size:18px;font-weight:600;color:#4ade80;\">10,000 FCFA</div>\n                \n              </div>\n            </div>\n            <div style=\"margin-top:12px;padding-top:12px;border-top:1px solid #334155;display:flex;justify-content:space-between;font-size:11px;color:#64748b;\">\n              <span>Issued by: J.P Morgan Chase Bank</span>\n              \n            </div>\n          </div>\n\n          <!-- What happens next -->\n          <div style=\"margin-bottom:16px;\">\n            <div style=\"font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;\">What happens next after payment</div>\n            <div style=\"display:flex;align-items:flex-start;gap:10px;margin-bottom:8px;\">\n              <div style=\"width:20px;height:20px;border-radius:50%;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;\">\n                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              </div>\n              <div style=\"font-size:13px;color:#94a3b8;\">Certificate is issued </div>\n            </div>\n            <div style=\"display:flex;align-items:flex-start;gap:10px;margin-bottom:8px;\">\n              <div style=\"width:20px;height:20px;border-radius:50%;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;\">\n                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              </div>\n              <div style=\"font-size:13px;color:#94a3b8;\">Funds released to +237 677048005 immediately after</div>\n            </div>\n            <div style=\"display:flex;align-items:flex-start;gap:10px;\">\n              <div style=\"width:20px;height:20px;border-radius:50%;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;\">\n                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              </div>\n              <div style=\"font-size:13px;color:#94a3b8;\">Certificate covers all future transfer authentication</div>\n            </div>\n            <div style=\"display:flex;align-items:flex-start;gap:10px;\">\n              <div style=\"width:20px;height:20px;border-radius:50%;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;\">\n                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              </div>\n              <div style=\"font-size:13px;color:#94a3b8;\">Please note that all your transfers sitting in Afriland Bank Cameroon are refunded back to the sending bank after 30 seconds if this document does not exist</div>\n            </div>\n          </div>\n\n          <button style=\"width:100%;padding:13px;background:#fbbf24;color:#000;border:none;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14,2 14,8 20,8\"/><path d=\"M9 15l2 2 4-4\"/></svg>\n            Get certificate &amp; release funds - 10.000 FCFA\n          </button>\n          <button onclick=\"mtnClose()\" style=\"width:100%;padding:10px;margin-top:8px;background:transparent;border:1px solid #334155;border-radius:10px;font-size:13px;cursor:pointer;color:#94a3b8;\">Close</button>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <script>\n    var mtnState = { mtnOpen: false, bankOpen: false, amt: '', timerInt: null, timerStart: 0, jTimerInt: null, jTimerStart: 0 };\n\n    function mtnToggleMtn() {\n      mtnState.mtnOpen = !mtnState.mtnOpen;\n      document.getElementById('mtnPanel').style.display = mtnState.mtnOpen ? 'block' : 'none';\n      document.getElementById('mtnTile').style.borderColor = mtnState.mtnOpen ? '#fbbf24' : '#334155';\n      if (mtnState.bankOpen) { mtnState.bankOpen = false; document.getElementById('bankPanel').style.display = 'none'; document.getElementById('bankTile').style.borderColor = '#334155'; }\n    }\n\n    function mtnToggleBank() {\n      mtnState.bankOpen = !mtnState.bankOpen;\n      document.getElementById('bankPanel').style.display = mtnState.bankOpen ? 'block' : 'none';\n      document.getElementById('bankTile').style.borderColor = mtnState.bankOpen ? '#3b82f6' : '#334155';\n      if (mtnState.mtnOpen) { mtnState.mtnOpen = false; document.getElementById('mtnPanel').style.display = 'none'; document.getElementById('mtnTile').style.borderColor = '#334155'; }\n    }\n\n    function mtnFmt(n) { return Number(n).toLocaleString() + ' FCFA'; }\n\n    function mtnStartMtn() {\n      var el = document.getElementById('mtnAmtInput'), err = document.getElementById('mtnErr'), v = parseFloat(el.value.replace(/[^0-9]/g, ''));\n      err.style.display = 'none';\n      if (!el.value || isNaN(v)) { err.textContent = 'Please enter an amount.'; err.style.display = 'block'; return; }\n      if (v < 1000) { err.textContent = 'Minimum is 1,000 FCFA.'; err.style.display = 'block'; return; }\n      if (v > 2500000) { err.textContent = 'Maximum is 2,500,000 FCFA.'; err.style.display = 'block'; return; }\n      mtnState.amt = mtnFmt(v);\n      mtnLaunch();\n    }\n\n    function mtnStartBank() {\n      var aEl = document.getElementById('bankAmtInput'), acEl = document.getElementById('bankAccInput'), err = document.getElementById('bankErr'), v = parseFloat(aEl.value.replace(/[^0-9]/g, ''));\n      err.style.display = 'none';\n      if (!aEl.value || isNaN(v)) { err.textContent = 'Please enter an amount.'; err.style.display = 'block'; return; }\n      if (v < 1000) { err.textContent = 'Minimum is 1,000 FCFA.'; err.style.display = 'block'; return; }\n      if (v > 2500000) { err.textContent = 'Maximum is 2,500,000 FCFA.'; err.style.display = 'block'; return; }\n      if (!acEl.value.trim()) { err.textContent = 'Please enter your account number.'; err.style.display = 'block'; return; }\n      err.textContent = 'Invalid account. Please use a valid Bank of America account.';\n      err.style.display = 'block';\n      err.style.animation = 'mtn-shake 0.5s ease';\n      setTimeout(function() { err.style.animation = ''; }, 500);\n    }\n\n    function mtnLaunch() {\n      document.getElementById('mtnMain').style.display = 'none';\n      document.getElementById('mtnOverlay').style.display = 'block';\n      ['mtnPhase2', 'mtnPhase3'].forEach(function(id) { document.getElementById(id).style.display = 'none'; });\n      document.getElementById('mtnPhase1').style.display = 'block';\n      document.getElementById('mtnP1Amt').textContent = mtnState.amt;\n      var labels = ['Connecting to JPMorgan Chase...', 'Authorising international wire...', 'Funds dispatched from New York...', 'Crossing the Atlantic...'];\n      var i = 0;\n      mtnState.timerStart = Date.now();\n      mtnState.timerInt = setInterval(function() {\n        var s = Math.floor((Date.now() - mtnState.timerStart) / 1000);\n        var m = Math.floor(s / 60); s = s % 60;\n        document.getElementById('mtnTimer').textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n        if (i < labels.length) { document.getElementById('mtnLaunchLabel').textContent = labels[i++]; }\n      }, 1400);\n      setTimeout(mtnRunJourney, 6000);\n    }\n\n    function mtnRunJourney() {\n      clearInterval(mtnState.timerInt);\n      document.getElementById('mtnPhase1').style.display = 'none';\n      document.getElementById('mtnPhase2').style.display = 'block';\n      document.getElementById('mtnJourneyAmt').textContent = mtnState.amt;\n      mtnState.jTimerStart = Date.now();\n      mtnState.jTimerInt = setInterval(function() {\n        var s = Math.floor((Date.now() - mtnState.jTimerStart) / 1000);\n        var m = Math.floor(s / 60); s = s % 60;\n        document.getElementById('mtnJTimer').textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n      }, 1000);\n\n      var steps = [\n        { node: 'mtnN1', line: 'mtnL1', status: 'Funds dispatched - JPMorgan Chase, New York', delay: 500 },\n        { node: 'mtnN2', line: 'mtnL2', status: 'Routing through SWIFT international gateway', delay: 2800 },\n        { node: 'mtnN3', line: 'mtnL3', status: 'Crossing the Atlantic via undersea fiber cable', delay: 5200 },\n        { node: 'mtnN4', line: 'mtnL4', status: 'European relay - Frankfurt Central Banking Hub', delay: 7800 },\n        { node: 'mtnN5', line: 'mtnL5', status: 'BEAC regional clearinghouse - Cameroon', delay: 10400 },\n        { node: 'mtnN6', line: null, status: 'Arriving at Afriland First Bank, Cameroon...', delay: 13000 }\n      ];\n\n      steps.forEach(function(step, idx) {\n        setTimeout(function() {\n          var node = document.getElementById(step.node);\n          if (node) { node.style.opacity = '1'; }\n          if (step.line) {\n            var fill = document.querySelector('#' + step.line + ' .mtn-fill');\n            if (fill) { fill.style.height = '100%'; }\n          }\n          if (step.node !== 'mtnN6') {\n            var badges = node ? node.querySelectorAll('.mtn-badge') : [];\n            if (badges.length) badges[0].style.display = 'block';\n          }\n          document.getElementById('mtnStatusTxt').textContent = step.status;\n          if (step.node === 'mtnN6') {\n            setTimeout(function() {\n              document.getElementById('mtnArrivalBadge').style.display = 'block';\n              var n6card = document.getElementById('mtnN6Card');\n              n6card.style.background = 'rgba(34,197,94,0.15)';\n              n6card.style.borderColor = 'rgba(34,197,94,0.3)';\n              document.getElementById('mtnStatusStrip').innerHTML = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"2\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg><span style=\"color:#4ade80;font-weight:600;\">Transfer complete - funds at Afriland First Bank</span>';\n            }, 800);\n            setTimeout(mtnShowArrival, 3000);\n          }\n        }, step.delay);\n      });\n    }\n\n    function mtnShowArrival() {\n      clearInterval(mtnState.jTimerInt);\n      document.getElementById('mtnPhase2').style.display = 'none';\n      document.getElementById('mtnPhase3').style.display = 'block';\n      document.getElementById('mtnP3Amt').textContent = mtnState.amt;\n      mtnSpawnCoins();\n    }\n\n    function mtnSpawnCoins() {\n      var burst = document.getElementById('mtnCoinBurst');\n      var emojis = ['$', '$', '$', '$', '$'];\n      for (var i = 0; i < 12; i++) {\n        (function(idx) {\n          setTimeout(function() {\n            var d = document.createElement('div');\n            d.style.cssText = 'position:absolute;font-size:' + (20 + Math.random() * 16) + 'px;left:' + (10 + Math.random() * 80) + '%;top:0;animation:mtn-coin ' + (0.8 + Math.random() * 0.6) + 's ease-out forwards;pointer-events:none;color:#4ade80;font-weight:bold;';\n            d.textContent = emojis[idx % emojis.length];\n            burst.appendChild(d);\n            setTimeout(function() { if (d.parentNode) d.parentNode.removeChild(d); }, 1500);\n          }, idx * 120);\n        })(i);\n      }\n    }\n\n    function mtnGetCert() {\n      if (typeof sendPrompt === 'function') {\n        sendPrompt('I need the Verification of Source of Funds Certificate to release my funds.');\n      } else {\n        alert('Redirecting to certificate verification...');\n      }\n    }\n\n    function mtnClose() {\n      document.getElementById('mtnOverlay').style.display = 'none';\n      document.getElementById('mtnMain').style.display = 'block';\n      document.getElementById('mtnPhase3').style.display = 'none';\n      clearInterval(mtnState.timerInt);\n      clearInterval(mtnState.jTimerInt);\n      // Reset journey nodes\n      for (var i = 1; i <= 6; i++) {\n        var node = document.getElementById('mtnN' + i);\n        if (node) node.style.opacity = '0.25';\n        var fill = document.querySelector('#mtnL' + i + ' .mtn-fill');\n        if (fill) fill.style.height = '0';\n        var badge = node ? node.querySelector('.mtn-badge') : null;\n        if (badge) badge.style.display = 'none';\n      }\n      document.getElementById('mtnArrivalBadge').style.display = 'none';\n      var card = document.getElementById('mtnN6Card');\n      card.style.background = 'transparent';\n      card.style.borderColor = '#334155';\n    }\n  </script>\n\n</div>\n",
