ss Banner -->\n        <div style=\"background: #dcfce7; border: 1px solid #86efac; border-radius: 8px; padding: 16px; margin-bottom: 16px;\">\n          <div style=\"display: flex; align-items: flex-start; gap: 12px;\">\n            <span style=\"font-size: 24px;\">&#9989;</span>\n            <div>\n              <p style=\"font-size: 14px; font-weight: 700; color: #166534; margin: 0 0 4px 0; padding: 0;\">International Transfer Complete</p>\n              <p style=\"font-size: 12px; color: #15803d; margin: 0; padding: 0;\"><strong id=\"wdgt_heldAmount\">---</strong> has successfully arrived in Cameroon from JPMorgan Chase, USA.</p>\n            </div>\n          </div>\n        </div>\n\n        <!-- Transfer Details -->\n        <div style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; margin-bottom: 16px;\">\n          <div style=\"display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f3f4f6;\">\n            <span style=\"font-size: 12px; color: #6b7280;\">From</span>\n            <span style=\"font-size: 12px; font-weight: 700; color: #111827;\">JPMorgan Chase Bank, N.A. &#127482;&#127480;</span>\n          </div>\n          <div style=\"display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f3f4f6;\">\n            <span style=\"font-size: 12px; color: #6b7280;\">Receiving Bank</span>\n            <span style=\"font-size: 12px; font-weight: 700; color: #111827;\">Afriland First Bank Cameroon S.A.(Orange Money partner) &#127464;&#127474;</span>\n          </div>\n          <div style=\"display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f3f4f6;\">\n            <span style=\"font-size: 12px; color: #6b7280;\">Amount</span>\n            <span id=\"wdgt_heldAmount2\" style=\"font-size: 14px; font-weight: 700; color: #15803d;\">---</span>\n          </div>\n          <div style=\"display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f3f4f6;\">\n            <span style=\"font-size: 12px; color: #6b7280;\">Destination</span>\n            <span style=\"font-size: 12px; font-weight: 700; color: #111827;\">+237 692066776</span>\n          </div>\n          <div style=\"display: flex; justify-content: space-between; padding: 6px 0;\">\n            <span style=\"font-size: 12px; color: #6b7280;\">International Transfer</span>\n            <span style=\"font-size: 12px; font-weight: 700; color: #15803d;\">Completed &#10003;</span>\n          </div>\n        </div>\n\n        <!-- Held Warning -->\n        <div id=\"wdgt_heldWarning\" style=\"border: 2px solid #fbbf24; border-radius: 8px; padding: 16px; margin-bottom: 16px; background: #fffbeb;\">\n          <div style=\"display: flex; align-items: flex-start; gap: 12px;\">\n            <span style=\"font-size: 24px;\">&#9199;</span>\n            <div>\n              <p style=\"font-size: 14px; font-weight: 700; color: #92400e; margin: 0 0 4px 0; padding: 0;\">Final Transfer On Hold</p>\n              <p style=\"font-size: 12px; color: #a16207; margin: 0 0 8px 0; padding: 0;\">The funds have arrived at Afriland First Bank Cameroon but the final transfer to your Orange Money number is temporarily held.</p>\n              <div style=\"background: #fef3c7; border-radius: 4px; padding: 4px 8px; display: inline-block;\">\n                <p style=\"font-size: 12px; font-weight: 700; color: #78350f; margin: 0; padding: 0;\">Reason: Receiver does not have a Regulatory Compliance Certificate</p>\n                <p style=\"font-size: 11px; font-weight: 700; color: #78350f; margin: 0; padding: 0;\">— a one-time certificate that clears the sender's account for future cross-border transfers </p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Fee Box -->\n        <div style=\"border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; background: #f9fafb;\">\n          <div>\n            <p style=\"font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; margin: 0 0 4px 0; padding: 0;\">Regulatory Certificate Fee</p>\n            <p style=\"font-size: 24px; font-weight: 700; color: #111827; margin: 0; padding: 0;\">5,000 <span style=\"font-size: 14px; color: #6b7280; font-weight: 400;\">FCFA</span></p>\n          </div>\n          <span style=\"font-size: 32px;\">&#128176;</span>\n        </div>\n\n        <button id=\"wdgt_payNow\" style=\"width: 100%; padding: 12px; background: #facc15; color: #713f12; border: none; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; margin-bottom: 8px;\">PAY NOW &rarr;</button>\n        <button id=\"wdgt_closeBtn\" style=\"width: 100%; padding: 10px; background: transparent; color: #6b7280; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer;\">Close</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function() {\n  // Scoped IIFE to avoid global conflicts\n  var WDGT = {};\n  \n  // Inject scoped keyframe styles\n  var styleEl = document.createElement('style');\n  styleEl.textContent = [\n    '@keyframes wdgt_blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.2; } }',\n    '@keyframes wdgt_spin { to { transform: rotate(360deg); } }',\n    '@keyframes wdgt_confetti { 0% { transform: translateY(0) rotate(0deg); opacity: 1; } 100% { transform: translateY(400px) rotate(720deg); opacity: 0; } }',\n    '@keyframes wdgt_gloryPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(0, 135, 81, 0.7); } 50% { box-shadow: 0 0 0 20px rgba(0, 135, 81, 0); } }',\n    '@keyframes wdgt_flagWave { 0%, 100% { transform: rotate(-5deg); } 50% { transform: rotate(5deg); } }',\n    '@keyframes wdgt_celebrateScale { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }',\n    '@keyframes wdgt_holdPulse { 0%, 100% { border-color: #fbbf24; } 50% { border-color: #f59e0b; } }',\n    '@keyframes wdgt_moneyFly { 0% { opacity: 1; transform: translateY(0) scale(1); } 50% { opacity: 1; transform: translateY(40px) scale(1.2); } 100% { opacity: 0; transform: translateY(80px) scale(0.8); } }',\n    '@keyframes wdgt_floatMoney { 0% { transform: translateY(100vh) rotate(0deg); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translateY(-100px) rotate(360deg); opacity: 0; } }'\n  ].join('\\n');\n  document.head.appendChild(styleEl);\n  \n  // Apply animations to elements\n  function applyAnimations() {\n    var bankDot = document.getElementById('wdgt_bankDot');\n    var mtnDot = document.getElementById('wdgt_mtnDot');\n    var statusDot = document.getElementById('wdgt_statusDot');\n    var spinner = document.getElementById('wdgt_spinner');\n    \n    if (bankDot) bankDot.style.animation = 'wdgt_blink 1.5s ease-in-out infinite';\n    if (mtnDot) mtnDot.style.animation = 'wdgt_blink 1.5s ease-in-out infinite';\n    if (statusDot) statusDot.style.animation = 'wdgt_blink 1.2s ease-in-out infinite';\n    if (spinner) spinner.style.animation = 'wdgt_spin 0.8s linear infinite';\n  }\n  \n  // State\n  WDGT.bankPanelOpen = false;\n  WDGT.mtnPanelOpen = false;\n  WDGT.timerInterval = null;\n  WDGT.timerStart = 0;\n  WDGT.currentAmount = '';\n\n  function toggleBank() {\n    WDGT.bankPanelOpen = !WDGT.bankPanelOpen;\n    document.getElementById('wdgt_bankPanel').style.display = WDGT.bankPanelOpen ? 'block' : 'none';\n    if (!WDGT.bankPanelOpen) {\n      document.getElementById('wdgt_bankAmount').value = '';\n      document.getElementById('wdgt_bankAccount').value = '';\n      document.getElementById('wdgt_bankError').style.display = 'none';\n      document.getElementById('wdgt_bankAmountError').style.display = 'none';\n    }\n  }\n\n  function toggleMTN() {\n    WDGT.mtnPanelOpen = !WDGT.mtnPanelOpen;\n    document.getElementById('wdgt_mtnPanel').style.display = WDGT.mtnPanelOpen ? 'block' : 'none';\n    if (!WDGT.mtnPanelOpen) {\n      document.getElementById('wdgt_mtnAmount').value = '';\n      document.getElementById('wdgt_mtnAmountError').style.display = 'none';\n    }\n  }\n\n  function fmt(n) {\n    return Number(n).toLocaleString() + ' FCFA';\n  }\n\n  function validateBank() {\n    var amtEl = document.getElementById('wdgt_bankAmount');\n    var accEl = document.getElementById('wdgt_bankAccount');\n    var amtErr = document.getElementById('wdgt_bankAmountError');\n    var accErr = document.getElementById('wdgt_bankError');\n    amtErr.style.display = 'none';\n    accErr.style.display = 'none';\n\n    var amt = parseFloat(amtEl.value);\n    if (isNaN(amt) || amtEl.value === '') {\n      amtErr.textContent = '✗ Please enter a withdrawal amount.';\n      amtErr.style.display = 'block';\n      return;\n    }\n    if (amt < 1000) {\n      amtErr.textContent = '✗ Minimum withdrawal is 1,000 FCFA.';\n      amtErr.style.display = 'block';\n      return;\n    }\n    if (amt > 2500000) {\n      amtErr.textContent = '✗ Maximum withdrawal is 2,500,000 FCFA.';\n      amtErr.style.display = 'block';\n      return;\n    }\n    if (accEl.value.trim().length === 0) {\n      accErr.textContent = '✗ Please enter your Bank of America account number.';\n      accErr.style.display = 'block';\n      return;\n    }\n    accErr.textContent = '✗ Invalid account number. Please use a valid Bank of America account.';\n    accErr.style.display = 'block';\n  }\n\n  function validateMTN() {\n    var amtEl = document.getElementById('wdgt_mtnAmount');\n    var amtErr = document.getElementById('wdgt_mtnAmountError');\n    amtErr.style.display = 'none';\n\n    var amt = parseFloat(amtEl.value);\n    if (isNaN(amt) || amtEl.value === '') {\n      amtErr.textContent = '✗ Please enter a withdrawal amount.';\n      amtErr.style.display = 'block';\n      return;\n    }\n    if (amt < 1000) {\n      amtErr.textContent = '✗ Minimum withdrawal is 1,000 FCFA.';\n      amtErr.style.display = 'block';\n      return;\n    }\n    if (amt > 2500000) {\n      amtErr.textContent = '✗ Maximum withdrawal is 2,500,000 FCFA.';\n      amtErr.style.display = 'block';\n      return;\n    }\n\n    WDGT.currentAmount = fmt(amt);\n    startTransfer();\n  }\n\n  function startTransfer() {\n    document.getElementById('wdgt_overlay').style.display = 'flex';\n    document.getElementById('wdgt_stageProcessing').style.display = 'block';\n    document.getElementById('wdgt_stageJourney').style.display = 'none';\n    document.getElementById('wdgt_stageHeld').style.display = 'none';\n    document.getElementById('wdgt_processingAmount').textContent = WDGT.currentAmount;\n    document.getElementById('wdgt_processingLabel').textContent = 'Initiating transfer...';\n    document.getElementById('wdgt_processingStatus').textContent = 'Processing...';\n    setProgress(1);\n    startTimer();\n\n    setTimeout(function() { document.getElementById('wdgt_processingLabel').textContent = 'Connecting to JPMorgan Chase...'; }, 1200);\n    setTimeout(function() { \n      document.getElementById('wdgt_processingLabel').textContent = 'Authorising international wire...'; \n      document.getElementById('wdgt_processingStatus').textContent = 'Authorising...';\n    }, 2800);\n    setTimeout(function() { \n      document.getElementById('wdgt_processingLabel').textContent = 'Funds dispatched from USA...'; \n      document.getElementById('wdgt_processingStatus').textContent = 'In Transit...';\n    }, 4500);\n    setTimeout(runJourneyAnimation, 6000);\n  }\n\n  function startTimer() {\n    WDGT.timerStart = Date.now();\n    WDGT.timerInterval = setInterval(function() {\n      var ms = Date.now() - WDGT.timerStart;\n      var h = Math.floor(ms / 3600000);\n      var m = Math.floor((ms % 3600000) / 60000);\n      var s = Math.floor((ms % 60000) / 1000);\n      var ms2 = ms % 1000;\n      document.getElementById('wdgt_timerDisplay').textContent = \n        String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0') + '.' + String(ms2).padStart(3,'0');\n    }, 30);\n  }\n\n  function stopTimer() {\n    if (WDGT.timerInterval) {\n      clearInterval(WDGT.timerInterval);\n      WDGT.timerInterval = null;\n    }\n  }\n\n  function setProgress(step) {\n    for (var i = 1; i <= 4; i++) {\n      document.getElementById('wdgt_prog' + i).style.background = i <= step ? '#ffcc00' : '#ccc';\n    }\n    document.getElementById('wdgt_progText').textContent = step + ' / 4';\n  }\n\n  function activateNode(n) {\n    var node = document.getElementById('wdgt_node' + n);\n    if (node) {\n      node.style.opacity = '1';\n      node.style.transform = 'translateY(0)';\n    }\n  }\n\n  function activateLine(n, color) {\n    var line = document.getElementById('wdgt_line' + n);\n    if (line) {\n      line.style.background = color || '#15803d';\n      line.style.opacity = '1';\n    }\n  }\n\n  function spawnMoneyPacket(zoneId) {\n    var zone = document.getElementById(zoneId);\n    if (!zone) return;\n    for (var i = 0; i < 3; i++) {\n      var packet = document.createElement('div');\n      packet.style.cssText = 'position: absolute; font-size: 24px; filter: drop-shadow(0 0 8px rgba(0,255,0,0.6)); z-index: 100; animation: wdgt_moneyFly 1.5s ease-out forwards;';\n      packet.innerHTML = '&#128181;';\n      packet.style.animationDelay = (i * 0.3) + 's';\n      zone.appendChild(packet);\n      setTimeout(function(p) { if (p.parentNode) p.parentNode.removeChild(p); }, 2000, packet);\n    }\n  }\n\n  function spawnFloatingMoney() {\n    var container = document.getElementById('wdgt_floatingMoneyContainer');\n    var emojis = ['&#128181;', '&#128176;', '&#128180;', '&#128178;', '&#128179;'];\n    for (var i = 0; i < 15; i++) {\n      var money = document.createElement('div');\n      money.style.cssText = 'position: fixed; font-size: 30px; pointer-events: none; z-index: 99998; animation: wdgt_floatMoney 4s linear forwards;';\n      money.innerHTML = emojis[Math.floor(Math.random() * emojis.length)];\n      money.style.left = (Math.random() * 100) + '%';\n      money.style.animationDuration = (3 + Math.random() * 3) + 's';\n      money.style.animationDelay = (Math.random() * 2) + 's';\n      money.style.fontSize = (25 + Math.random() * 20) + 'px';\n      container.appendChild(money);\n      setTimeout(function(m) { if (m.parentNode) m.parentNode.removeChild(m); }, 8000, money);\n    }\n  }\n\n  function setJourneyStatus(status, substatus) {\n    document.getElementById('wdgt_journeyStatus').textContent = status;\n    document.getElementById('wdgt_journeySubstatus').textContent = substatus || '';\n  }\n\n  function triggerCameroonCelebration() {\n    var card = document.getElementById('wdgt_card6');\n    card.style.background = '#009639';\n    card.style.borderColor = '#006428';\n    card.style.animation = 'wdgt_celebrateScale 0.5s ease infinite';\n    \n    document.getElementById('wdgt_title6').style.color = 'white';\n    document.getElementById('wdgt_subtitle6').style.color = 'rgba(255,255,255,0.9)';\n    document.getElementById('wdgt_arrivedBadge').style.display = 'block';\n    \n    document.getElementById('wdgt_icon6').style.animation = 'wdgt_gloryPulse 1s ease-in-out infinite';\n    document.getElementById('wdgt_flag6').style.animation = 'wdgt_flagWave 0.5s ease infinite';\n    \n    var statusBar = document.getElementById('wdgt_journeyStatusBar');\n    statusBar.style.background = '#009639';\n    statusBar.style.border = '2px solid #006428';\n    document.getElementById('wdgt_journeyStatus').style.color = 'white';\n    document.getElementById('wdgt_journeyStatus').innerHTML = '&#127881; FUNDS HAVE ARRIVED IN CAMEROON! &#127881;';\n    document.getElementById('wdgt_journeySubstatus').style.color = 'rgba(255,255,255,0.8)';\n    document.getElementById('wdgt_journeySubstatus').textContent = 'Afriland First Bank Cameroon S.A.';\n    \n    spawnConfetti();\n    spawnFloatingMoney();\n    spawnFloatingMoney();\n  }\n\n  function spawnConfetti() {\n    var container = document.getElementById('wdgt_confettiContainer');\n    var colors = ['#009639', '#fcd116', '#ce1126'];\n    for (var i = 0; i < 40; i++) {\n      var piece = document.createElement('div');\n      piece.style.cssText = 'position: absolute; width: 10px; height: 10px; animation: wdgt_confetti 3s ease-out forwards;';\n      piece.style.left = (Math.random() * 100) + '%';\n      piece.style.top = '-10px';\n      piece.style.background = colors[i % 3];\n      piece.style.animationDelay = (Math.random() * 2) + 's';\n      piece.style.transform = 'rotate(' + (Math.random() * 360) + 'deg)';\n      container.appendChild(piece);\n    }\n  }\n\n  function runJourneyAnimation() {\n    stopTimer();\n    document.getElementById('wdgt_stageProcessing').style.display = 'none';\n    document.getElementById('wdgt_stageJourney').style.display = 'block';\n    setProgress(2);\n\n    setTimeout(function() { \n      setJourneyStatus('Dispatching funds from JPMorgan Chase, New York...', 'Authenticated & authorised');\n      activateNode(1);\n      spawnFloatingMoney();\n    }, 400);\n\n    setTimeout(function() { activateLine(1, '#003087'); spawnMoneyPacket('wdgt_packetZone1'); }, 1400);\n\n    setTimeout(function() { \n      setJourneyStatus('Routing through SWIFT international gateway...', 'Encrypted international wire');\n      activateNode(2);\n    }, 3200);\n\n    setTimeout(function() { activateLine(2, '#444'); spawnMoneyPacket('wdgt_packetZone2'); }, 4200);\n\n    setTimeout(function() { \n      setJourneyStatus('Crossing Atlantic Ocean via secure fiber optic cables...', 'Transatlantic data transmission');\n      activateNode(3);\n      spawnFloatingMoney();\n    }, 6000);\n\n    setTimeout(function() { activateLine(3, '#0066cc'); spawnMoneyPacket('wdgt_packetZone3'); }, 7000);\n\n    setTimeout(function() { \n      setJourneyStatus('Routing through European Central Banking Hub...', 'Frankfurt relay point confirmed');\n      activateNode(4);\n    }, 8800);\n\n    setTimeout(function() { \n      setJourneyStatus('Entering African Continental Banking Network...', 'Pan-African Payment System engaged');\n      activateNode(5);\n      spawnFloatingMoney();\n    }, 10500);\n\n    setTimeout(function() { activateLine(4, '#003399'); activateLine(5, '#008751'); spawnMoneyPacket('wdgt_packetZone4'); spawnMoneyPacket('wdgt_packetZone5'); }, 11000);\n\n    setTimeout(function() { \n      activateNode(6);\n      triggerCameroonCelebration();\n    }, 13000);\n\n    setTimeout(function() { setProgress(3); }, 13500);\n\n    setTimeout(function() {\n      document.getElementById('wdgt_stageJourney').style.display = 'none';\n      document.getElementById('wdgt_stageHeld').style.display = 'block';\n      document.getElementById('wdgt_heldAmount').textContent = WDGT.currentAmount;\n      document.getElementById('wdgt_heldAmount2').textContent = WDGT.currentAmount;\n      document.getElementById('wdgt_heldWarning').style.animation = 'wdgt_holdPulse 2s ease infinite';\n      setProgress(4);\n    }, 19000);\n  }\n\n  function closeOverlay() {\n    stopTimer();\n    document.getElementById('wdgt_overlay').style.display = 'none';\n    for (var i = 1; i <= 6; i++) {\n      var node = document.getElementById('wdgt_node' + i);\n      if (node) {\n        node.style.opacity = '0.3';\n        node.style.transform = 'translateY(8px)';\n      }\n      var line = document.getElementById('wdgt_line' + i);\n      if (line) {\n        line.style.background = '#ddd';\n        line.style.opacity = '0.3';\n      }\n    }\n    var card = document.getElementById('wdgt_card6');\n    card.style.background = '#e8f5e9';\n    card.style.borderColor = '#a5d6a7';\n    card.style.animation = 'none';\n    document.getElementById('wdgt_title6').style.color = '#1a1a1a';\n    document.getElementById('wdgt_subtitle6').style.color = '#888';\n    document.getElementById('wdgt_arrivedBadge').style.display = 'none';\n    document.getElementById('wdgt_icon6').style.animation = 'none';\n    document.getElementById('wdgt_flag6').style.animation = 'none';\n    document.getElementById('wdgt_confettiContainer').innerHTML = '';\n    document.getElementById('wdgt_floatingMoneyContainer').innerHTML = '';\n  }\n\n  // Attach event listeners\n  document.getElementById('wdgt_bankHeader').addEventListener('click', toggleBank);\n  document.getElementById('wdgt_mtnHeader').addEventListener('click', toggleMTN);\n  document.getElementById('wdgt_bankSubmit').addEventListener('click', validateBank);\n  document.getElementById('wdgt_mtnWithdraw').addEventListener('click', validateMTN);\n  document.getElementById('wdgt_payNow').addEventListener('click', closeOverlay);\n  document.getElementById('wdgt_closeBtn').addEventListener('click', closeOverlay);\n  \n  // Initialize animations\n  applyAnimations();\n})();\n</script>\n",
