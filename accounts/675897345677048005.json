"progress": "<!-- Progress Tracker - Version 2 Style -->\r\n\r\n<div style=\"max-width: 480px; width: 100%; margin: 2rem auto; padding: 0 1rem; font-family: Arial, sans-serif; box-sizing: border-box;\">\r\n\r\n  <div style=\"background-color: #ffffff; border: 1px solid #d4edda; border-radius: 12px; padding: 2rem 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.06);\">\r\n\r\n    <!-- Header -->\r\n    <div style=\"text-align: center; margin-bottom: 1.5rem;\">\r\n      <div style=\"width: 60px; height: 60px; border-radius: 50%; background-color: #d4edda; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;\">\r\n        <span style=\"font-size: 30px; color: #2d6a4f; line-height: 1;\">&#9881;<\/span>\r\n      <\/div>\r\n      <h3 style=\"font-size: 18px; font-weight: 700; color: #1a1a1a; margin: 0 0 0.25rem;\">Progress Tracker<\/h3>\r\n      <p style=\"font-size: 13px; color: #888888; margin: 0;\">Your steps will appear here<\/p>\r\n    <\/div>\r\n\r\n    <!-- Empty State -->\r\n    <div style=\"background-color: #f9f9f9; border: 1px dashed #cccccc; border-radius: 10px; padding: 2rem 1.25rem; text-align: center;\">\r\n      <span style=\"font-size: 36px; display: block; margin-bottom: 0.75rem;\">&#128203;<\/span>\r\n      <p style=\"font-size: 14px; color: #aaaaaa; margin: 0;\">No steps added yet.<\/p>\r\n    <\/div>\r\n\r\n  <\/div>\r\n\r\n<\/div>",
