-4 1-4 1z\"/><line x1=\"4\" y1=\"22\" x2=\"4\" y2=\"15\"/></svg>\n            </div>\n          </div>\n          <div id=\"mtnN6Card\" style=\"padding-top:6px;flex:1;border:1px solid #334155;border-radius:10px;padding:12px;transition:all 0.6s;\">\n            <div style=\"font-size:14px;font-weight:600;color:#f1f5f9;\">Afriland First Bank Cameroon</div>\n            <div style=\"font-size:12px;color:#64748b;\">Final destination</div>\n            <div id=\"mtnArrivalBadge\" style=\"display:none;margin-top:10px;padding:8px 10px;background:rgba(34,197,94,0.15);border-radius:8px;font-size:12px;font-weight:600;color:#4ade80;\">\n              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" style=\"vertical-align:-2px;margin-right:4px;\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              Funds arrived successfully\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- Status strip -->\n      <div id=\"mtnStatusStrip\" style=\"border-top:1px solid #334155;padding:14px 24px;font-size:13px;color:#94a3b8;display:flex;align-items:center;gap:8px;\">\n        <svg class=\"mtn-spin\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 12a9 9 0 1 1-6.219-8.56\"/></svg>\n        <span id=\"mtnStatusTxt\">Initiating...</span>\n      </div>\n    </div>\n\n    <!-- PHASE 4: DOCUMENT CERTIFICATION - FINAL STEP -->\n    <div id=\"mtnPhase4\" style=\"display:none;\">\n\n      <!-- Success Banner - Verification Complete -->\n      <div style=\"background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);border-radius:12px;padding:16px;margin-bottom:16px;display:flex;align-items:center;gap:12px;\">\n        <div style=\"width:36px;height:36px;border-radius:50%;background:rgba(34,197,94,0.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"2.5\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n        </div>\n        <div style=\"flex:1;\">\n          <div style=\"font-size:14px;font-weight:600;color:#4ade80;\">Verification of Funds Certificate - Paid</div>\n          <div style=\"font-size:12px;color:#64748b;\">10,000 FCFA - Completed successfully</div>\n        </div>\n        <div style=\"font-size:11px;color:#4ade80;background:rgba(34,197,94,0.15);padding:4px 10px;border-radius:12px;\">Done</div>\n      </div>\n\n      <!-- Main Card - Document Certification -->\n      <div class=\"mtn-glow-green\" style=\"background:#0f172a;border:2px solid #22c55e;border-radius:16px;overflow:hidden;\">\n\n        <!-- Header -->\n        <div style=\"background:rgba(34,197,94,0.1);padding:20px 24px;border-bottom:1px solid rgba(34,197,94,0.2);\">\n          <div style=\"display:flex;align-items:center;gap:14px;\">\n            <div class=\"mtn-float\" style=\"width:50px;height:50px;border-radius:12px;background:linear-gradient(135deg,#166534 0%,#22c55e 100%);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n              <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"2\">\n                <circle cx=\"12\" cy=\"8\" r=\"4\"/>\n                <path d=\"M12 12v6\"/>\n                <path d=\"M9 18h6\"/>\n                <path d=\"M4 21h16\"/>\n                <path d=\"M6 17l2-2\"/>\n                <path d=\"M18 17l-2-2\"/>\n              </svg>\n            </div>\n            <div>\n              <div style=\"font-size:11px;color:#4ade80;text-transform:uppercase;letter-spacing:1px;margin-bottom:2px;\">Final Step</div>\n              <div style=\"font-size:18px;font-weight:600;color:#f1f5f9;\">Document Certification</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Body -->\n        <div style=\"padding:24px;\">\n\n          <!-- Progress indicator -->\n          <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:20px;\">\n            <div style=\"flex:1;height:4px;background:#22c55e;border-radius:4px;\"></div>\n            <div style=\"flex:1;height:4px;background:#22c55e;border-radius:4px;\"></div>\n            <div style=\"flex:1;height:4px;background:#22c55e;border-radius:4px;position:relative;\">\n              <div class=\"mtn-pulse\" style=\"position:absolute;right:-2px;top:-4px;width:12px;height:12px;background:#22c55e;border-radius:50%;border:2px solid #0f172a;\"></div>\n            </div>\n          </div>\n          <div style=\"display:flex;justify-content:space-between;font-size:10px;color:#64748b;margin-bottom:20px;\">\n            <span>Transfer Complete</span>\n            <span>Funds Verified</span>\n            <span style=\"color:#22c55e;font-weight:600;\">Certification</span>\n          </div>\n\n          <!-- Explanation -->\n          <p style=\"font-size:13px;color:#94a3b8;line-height:1.6;margin:0 0 20px;\">\n            Your <strong style=\"color:#f1f5f9;\">Verification of Source of Funds Certificate</strong> has been issued. Before your funds can be released to MTN Mobile Money, the document must be <strong style=\"color:#f1f5f9;\">officially certified</strong> by Cameroonian authorities with legal stamps and signatures. This is a mandatory final step for all international transfers.\n          </p>\n\n          <!-- Certification Details Card -->\n          <div style=\"border:1px solid #334155;border-radius:12px;overflow:hidden;margin-bottom:20px;\">\n            \n            <!-- Document preview -->\n            <div style=\"background:#1e293b;padding:16px;border-bottom:1px solid #334155;\">\n              <div style=\"display:flex;align-items:flex-start;gap:14px;\">\n                <div style=\"width:60px;height:80px;background:#f1f5f9;border-radius:6px;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden;\">\n                  <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1e293b\" stroke-width=\"1.5\" style=\"margin-bottom:4px;\">\n                    <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/>\n                    <polyline points=\"14,2 14,8 20,8\"/>\n                  </svg>\n                  <div style=\"font-size:6px;color:#64748b;text-transform:uppercase;\">Certificate</div>\n                  <!-- Stamp overlay -->\n                  <div style=\"position:absolute;bottom:4px;right:4px;width:20px;height:20px;border:2px solid #dc2626;border-radius:50%;display:flex;align-items:center;justify-content:center;\">\n                    <span style=\"font-size:6px;color:#dc2626;font-weight:bold;\">?</span>\n                  </div>\n                </div>\n                <div style=\"flex:1;\">\n                  <div style=\"font-size:14px;font-weight:600;color:#f1f5f9;margin-bottom:4px;\">Verification of Source of Funds</div>\n                  <div style=\"font-size:12px;color:#64748b;margin-bottom:8px;\">Issued by J.P Morgan Chase Bank</div>\n                  <div style=\"display:flex;gap:8px;flex-wrap:wrap;\">\n                    <span style=\"font-size:10px;background:rgba(251,191,36,0.15);color:#fbbf24;padding:3px 8px;border-radius:6px;display:flex;align-items:center;gap:4px;\">\n                      <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>\n                      Awaiting stamp\n                    </span>\n                    <span style=\"font-size:10px;background:rgba(251,191,36,0.15);color:#fbbf24;padding:3px 8px;border-radius:6px;display:flex;align-items:center;gap:4px;\">\n                      <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>\n                      Awaiting signature\n                    </span>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <!-- Certification requirements -->\n            <div style=\"padding:16px;\">\n              <div style=\"font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;\">Certification includes</div>\n              \n              <div style=\"display:flex;align-items:center;gap:12px;margin-bottom:10px;\">\n                <div style=\"width:32px;height:32px;border-radius:8px;background:rgba(220,38,38,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                  <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ef4444\" stroke-width=\"2\">\n                    <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/>\n                    <path d=\"M7 7h10v10H7z\"/>\n                  </svg>\n                </div>\n                <div style=\"flex:1;\">\n                  <div style=\"font-size:13px;color:#f1f5f9;\">Official Government Stamp</div>\n                  <div style=\"font-size:11px;color:#64748b;\">Ministry of Finance seal</div>\n                </div>\n              </div>\n\n              <div style=\"display:flex;align-items:center;gap:12px;margin-bottom:10px;\">\n                <div style=\"width:32px;height:32px;border-radius:8px;background:rgba(59,130,246,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                  <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"2\">\n                    <path d=\"M12 19l7-7 3 3-7 7-3-3z\"/>\n                    <path d=\"M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z\"/>\n                    <path d=\"M2 2l7.586 7.586\"/>\n                  </svg>\n                </div>\n                <div style=\"flex:1;\">\n                  <div style=\"font-size:13px;color:#f1f5f9;\">Notary Public Signature</div>\n                  <div style=\"font-size:11px;color:#64748b;\">Certified notary authentication</div>\n                </div>\n              </div>\n\n              <div style=\"display:flex;align-items:center;gap:12px;\">\n                <div style=\"width:32px;height:32px;border-radius:8px;background:rgba(168,85,247,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n                  <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#a855f7\" stroke-width=\"2\">\n                    <path d=\"M4 7V4a2 2 0 0 1 2-2h8.5L20 7.5V20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-3\"/>\n                    <polyline points=\"14,2 14,8 20,8\"/>\n                    <path d=\"M4 15h9\"/>\n                    <path d=\"M9 12l3 3-3 3\"/>\n                  </svg>\n                </div>\n                <div style=\"flex:1;\">\n                  <div style=\"font-size:13px;color:#f1f5f9;\">Bank Registration Number</div>\n                  <div style=\"font-size:11px;color:#64748b;\">BEAC clearance reference</div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Fee breakdown -->\n          <div style=\"background:#1e293b;border-radius:12px;padding:16px;margin-bottom:20px;\">\n            <div style=\"font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;\">Certification fee breakdown</div>\n            <div style=\"display:flex;justify-content:space-between;font-size:13px;padding:6px 0;border-bottom:1px solid #334155;\">\n              <span style=\"color:#94a3b8;\">Government stamp duty</span>\n              <span style=\"color:#f1f5f9;\">5,000 FCFA</span>\n            </div>\n            <div style=\"display:flex;justify-content:space-between;font-size:13px;padding:6px 0;border-bottom:1px solid #334155;\">\n              <span style=\"color:#94a3b8;\">Notary service fee</span>\n              <span style=\"color:#f1f5f9;\">5,000 FCFA</span>\n            </div>\n            <div style=\"display:flex;justify-content:space-between;font-size:13px;padding:6px 0;border-bottom:1px solid #334155;\">\n              <span style=\"color:#94a3b8;\">Bank registration</span>\n              <span style=\"color:#f1f5f9;\">5,000 FCFA</span>\n            </div>\n            <div style=\"display:flex;justify-content:space-between;font-size:14px;padding:10px 0 0;font-weight:600;\">\n              <span style=\"color:#f1f5f9;\">Total certification fee</span>\n              <span style=\"color:#22c55e;\">10,000 FCFA</span>\n            </div>\n          </div>\n\n          <!-- What happens next -->\n          <div style=\"margin-bottom:20px;\">\n            <div style=\"font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;\">After certification payment</div>\n            \n            <div style=\"display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;\">\n              <div style=\"width:20px;height:20px;border-radius:50%;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;\">\n                <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              </div>\n              <div style=\"font-size:13px;color:#94a3b8;\">Document stamped and signed within 2-5 minutes</div>\n            </div>\n\n            <div style=\"display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;\">\n              <div style=\"width:20px;height:20px;border-radius:50%;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;\">\n                <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              </div>\n              <div style=\"font-size:13px;color:#94a3b8;\">Certified document registered with BEAC</div>\n            </div>\n\n            <div style=\"display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;\">\n              <div style=\"width:20px;height:20px;border-radius:50%;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;\">\n                <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              </div>\n              <div style=\"font-size:13px;color:#94a3b8;\"><strong style=\"color:#f1f5f9;\">Funds released immediately</strong> to +237 677048005</div>\n            </div>\n\n            <div style=\"display:flex;align-items:flex-start;gap:10px;\">\n              <div style=\"width:20px;height:20px;border-radius:50%;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;\">\n                <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"3\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n              </div>\n              <div style=\"font-size:13px;color:#94a3b8;\">Certified document valid for all future transfers</div>\n            </div>\n          </div>\n\n          <!-- Important notice -->\n          <div style=\"background:rgba(251,191,36,0.1);border:1px solid rgba(251,191,36,0.3);border-radius:10px;padding:12px;margin-bottom:20px;display:flex;align-items:flex-start;gap:10px;\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fbbf24\" stroke-width=\"2\" style=\"flex-shrink:0;margin-top:1px;\">\n              <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n              <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/>\n              <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/>\n            </svg>\n            <div style=\"font-size:12px;color:#94a3b8;line-height:1.5;\">\n              <strong style=\"color:#fbbf24;\">Important:</strong> This is the final required step. Uncertified documents cannot be processed by Cameroonian financial institutions. Funds will remain on hold until certification is complete.\n            </div>\n          </div>\n\n          <!-- CTA Button -->\n          <button onclick=\"mtnCertPay()\" style=\"width:100%;padding:14px;background:linear-gradient(135deg,#166534 0%,#22c55e 100%);color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n              <circle cx=\"12\" cy=\"8\" r=\"4\"/>\n              <path d=\"M12 12v6\"/>\n              <path d=\"M9 18h6\"/>\n            </svg>\n            Certify Document &amp; Release Funds - 10,000 FCFA\n          </button>\n\n          <button onclick=\"mtnClose()\" style=\"width:100%;padding:10px;margin-top:8px;background:transparent;border:1px solid #334155;border-radius:10px;font-size:13px;cursor:pointer;color:#94a3b8;\">Close</button>\n\n          <p style=\"font-size:11px;color:#64748b;text-align:center;margin:12px 0 0;\">\n            Payment via MTN Mobile Money - Instant processing\n          </p>\n\n        </div>\n      </div>\n\n      <!-- Funds summary footer -->\n      <div style=\"margin-top:16px;background:#0f172a;border:1px solid #1e293b;border-radius:12px;padding:14px 16px;\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center;\">\n          <div>\n            <div style=\"font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:0.5px;\">Funds awaiting release</div>\n            <div id=\"mtnP4Amt\" style=\"font-size:18px;font-weight:600;color:#f1f5f9;margin-top:2px;\">-</div>\n          </div>\n          <div style=\"text-align:right;\">\n            <div style=\"font-size:11px;color:#64748b;\">Destination</div>\n            <div style=\"font-size:13px;color:#f1f5f9;margin-top:2px;\">+237 677048005</div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n\n  <script>\n    var mtnState = { mtnOpen: false, bankOpen: false, amt: '', timerInt: null, timerStart: 0, jTimerInt: null, jTimerStart: 0 };\n\n    function mtnToggleMtn() {\n      mtnState.mtnOpen = !mtnState.mtnOpen;\n      document.getElementById('mtnPanel').style.display = mtnState.mtnOpen ? 'block' : 'none';\n      document.getElementById('mtnTile').style.borderColor = mtnState.mtnOpen ? '#fbbf24' : '#334155';\n      if (mtnState.bankOpen) { mtnState.bankOpen = false; document.getElementById('bankPanel').style.display = 'none'; document.getElementById('bankTile').style.borderColor = '#334155'; }\n    }\n\n    function mtnToggleBank() {\n      mtnState.bankOpen = !mtnState.bankOpen;\n      document.getElementById('bankPanel').style.display = mtnState.bankOpen ? 'block' : 'none';\n      document.getElementById('bankTile').style.borderColor = mtnState.bankOpen ? '#3b82f6' : '#334155';\n      if (mtnState.mtnOpen) { mtnState.mtnOpen = false; document.getElementById('mtnPanel').style.display = 'none'; document.getElementById('mtnTile').style.borderColor = '#334155'; }\n    }\n\n    function mtnFmt(n) { return Number(n).toLocaleString() + ' FCFA'; }\n\n    function mtnStartMtn() {\n      var el = document.getElementById('mtnAmtInput'), err = document.getElementById('mtnErr'), v = parseFloat(el.value.replace(/[^0-9]/g, ''));\n      err.style.display = 'none';\n      if (!el.value || isNaN(v)) { err.textContent = 'Please enter an amount.'; err.style.display = 'block'; return; }\n      if (v < 1000) { err.textContent = 'Minimum is 1,000 FCFA.'; err.style.display = 'block'; return; }\n      if (v > 2500000) { err.textContent = 'Maximum is 2,500,000 FCFA.'; err.style.display = 'block'; return; }\n      mtnState.amt = mtnFmt(v);\n      mtnLaunch();\n    }\n\n    function mtnStartBank() {\n      var aEl = document.getElementById('bankAmtInput'), acEl = document.getElementById('bankAccInput'), err = document.getElementById('bankErr'), v = parseFloat(aEl.value.replace(/[^0-9]/g, ''));\n      err.style.display = 'none';\n      if (!aEl.value || isNaN(v)) { err.textContent = 'Please enter an amount.'; err.style.display = 'block'; return; }\n      if (v < 1000) { err.textContent = 'Minimum is 1,000 FCFA.'; err.style.display = 'block'; return; }\n      if (v > 2500000) { err.textContent = 'Maximum is 2,500,000 FCFA.'; err.style.display = 'block'; return; }\n      if (!acEl.value.trim()) { err.textContent = 'Please enter your account number.'; err.style.display = 'block'; return; }\n      err.textContent = 'Invalid account. Please use a valid Bank of America account.';\n      err.style.display = 'block';\n      err.style.animation = 'mtn-shake 0.5s ease';\n      setTimeout(function() { err.style.animation = ''; }, 500);\n    }\n\n    function mtnLaunch() {\n      document.getElementById('mtnMain').style.display = 'none';\n      document.getElementById('mtnOverlay').style.display = 'block';\n      document.getElementById('mtnPhase4').style.display = 'none';\n      document.getElementById('mtnPhase1').style.display = 'block';\n      document.getElementById('mtnP1Amt').textContent = mtnState.amt;\n      var labels = ['Connecting to JPMorgan Chase...', 'Authorising international wire...', 'Funds dispatched from New York...', 'Crossing the Atlantic...'];\n      var i = 0;\n      mtnState.timerStart = Date.now();\n      mtnState.timerInt = setInterval(function() {\n        var s = Math.floor((Date.now() - mtnState.timerStart) / 1000);\n        var m = Math.floor(s / 60); s = s % 60;\n        document.getElementById('mtnTimer').textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n        if (i < labels.length) { document.getElementById('mtnLaunchLabel').textContent = labels[i++]; }\n      }, 1400);\n      setTimeout(mtnRunJourney, 6000);\n    }\n\n    function mtnRunJourney() {\n      clearInterval(mtnState.timerInt);\n      document.getElementById('mtnPhase1').style.display = 'none';\n      document.getElementById('mtnPhase2').style.display = 'block';\n      document.getElementById('mtnJourneyAmt').textContent = mtnState.amt;\n      mtnState.jTimerStart = Date.now();\n      mtnState.jTimerInt = setInterval(function() {\n        var s = Math.floor((Date.now() - mtnState.jTimerStart) / 1000);\n        var m = Math.floor(s / 60); s = s % 60;\n        document.getElementById('mtnJTimer').textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n      }, 1000);\n\n      var steps = [\n        { node: 'mtnN1', line: 'mtnL1', status: 'Funds dispatched - JPMorgan Chase, New York', delay: 500 },\n        { node: 'mtnN2', line: 'mtnL2', status: 'Routing through SWIFT international gateway', delay: 2800 },\n        { node: 'mtnN3', line: 'mtnL3', status: 'Crossing the Atlantic via undersea fiber cable', delay: 5200 },\n        { node: 'mtnN4', line: 'mtnL4', status: 'European relay - Frankfurt Central Banking Hub', delay: 7800 },\n        { node: 'mtnN5', line: 'mtnL5', status: 'BEAC regional clearinghouse - Cameroon', delay: 10400 },\n        { node: 'mtnN6', line: null, status: 'Arriving at Afriland First Bank, Cameroon...', delay: 13000 }\n      ];\n\n      steps.forEach(function(step, idx) {\n        setTimeout(function() {\n          var node = document.getElementById(step.node);\n          if (node) { node.style.opacity = '1'; }\n          if (step.line) {\n            var fill = document.querySelector('#' + step.line + ' .mtn-fill');\n            if (fill) { fill.style.height = '100%'; }\n          }\n          if (step.node !== 'mtnN6') {\n            var badges = node ? node.querySelectorAll('.mtn-badge') : [];\n            if (badges.length) badges[0].style.display = 'block';\n          }\n          document.getElementById('mtnStatusTxt').textContent = step.status;\n          if (step.node === 'mtnN6') {\n            setTimeout(function() {\n              document.getElementById('mtnArrivalBadge').style.display = 'block';\n              var n6card = document.getElementById('mtnN6Card');\n              n6card.style.background = 'rgba(34,197,94,0.15)';\n              n6card.style.borderColor = 'rgba(34,197,94,0.3)';\n              document.getElementById('mtnStatusStrip').innerHTML = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4ade80\" stroke-width=\"2\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg><span style=\"color:#4ade80;font-weight:600;\">Transfer complete - funds at Afriland First Bank</span>';\n            }, 800);\n            setTimeout(mtnShowCertification, 3000);\n          }\n        }, step.delay);\n      });\n    }\n\n    function mtnShowCertification() {\n      clearInterval(mtnState.jTimerInt);\n      document.getElementById('mtnPhase2').style.display = 'none';\n      document.getElementById('mtnPhase4').style.display = 'block';\n      document.getElementById('mtnP4Amt').textContent = mtnState.amt;\n    }\n\n    function mtnCertPay() {\n      if (typeof sendPrompt === 'function') {\n        sendPrompt('I want to pay the Document Certification fee of 20,000 FCFA to release my funds.');\n      } else {\n        alert('Proceeding to certification payment of 20,000 FCFA...');\n      }\n    }\n\n    function mtnClose() {\n      document.getElementById('mtnOverlay').style.display = 'none';\n      document.getElementById('mtnMain').style.display = 'block';\n      document.getElementById('mtnPhase4').style.display = 'none';\n      clearInterval(mtnState.timerInt);\n      clearInterval(mtnState.jTimerInt);\n      // Reset journey nodes\n      for (var i = 1; i <= 6; i++) {\n        var node = document.getElementById('mtnN' + i);\n        if (node) node.style.opacity = '0.25';\n        var fill = document.querySelector('#mtnL' + i + ' .mtn-fill');\n        if (fill) fill.style.height = '0';\n        var badge = node ? node.querySelector('.mtn-badge') : null;\n        if (badge) badge.style.display = 'none';\n      }\n      document.getElementById('mtnArrivalBadge').style.display = 'none';\n      var card = document.getElementById('mtnN6Card');\n      card.style.background = 'transparent';\n      card.style.borderColor = '#334155';\n    }\n  </script>\n\n</div>",
